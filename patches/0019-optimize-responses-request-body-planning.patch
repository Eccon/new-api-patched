+package relay
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/relayconvert"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type rawResponsesAdaptorContractCase struct {
+	name        string
+	apiType     int
+	channelType int
+	model       string
+	configure   func(*relaycommon.RelayInfo)
+	validate    func(*testing.T, dto.OpenAIResponsesRequest)
+}
+
+func rawResponsesAdaptorContractCases() []rawResponsesAdaptorContractCase {
+	reasoningSuffixValidation := func(wantModel, wantEffort string) func(*testing.T, dto.OpenAIResponsesRequest) {
+		return func(t *testing.T, converted dto.OpenAIResponsesRequest) {
+			t.Helper()
+			require.Equal(t, wantModel, converted.Model)
+			require.NotNil(t, converted.Reasoning)
+			require.Equal(t, wantEffort, converted.Reasoning.Effort)
+		}
+	}
+
+	return []rawResponsesAdaptorContractCase{
+		{
+			name:        "OpenAI",
+			apiType:     constant.APITypeOpenAI,
+			channelType: constant.ChannelTypeOpenAI,
+			model:       "gpt-5-high",
+			validate:    reasoningSuffixValidation("gpt-5", "high"),
+		},
+		{
+			name:        "OpenRouter",
+			apiType:     constant.APITypeOpenRouter,
+			channelType: constant.ChannelTypeOpenRouter,
+			model:       "gpt-5-high",
+			validate:    reasoningSuffixValidation("gpt-5", "high"),
+		},
+		{
+			name:        "Xinference",
+			apiType:     constant.APITypeXinference,
+			channelType: constant.ChannelTypeXinference,
+			model:       "gpt-5-high",
+			validate:    reasoningSuffixValidation("gpt-5", "high"),
+		},
+		{
+			name:        "DeepSeek",
+			apiType:     constant.APITypeDeepSeek,
+			channelType: constant.ChannelTypeDeepSeek,
+			model:       "deepseek-v4-chat-max",
+			validate:    reasoningSuffixValidation("deepseek-v4-chat", "max"),
+		},
+		{
+			name:        "Codex",
+			apiType:     constant.APITypeCodex,
+			channelType: constant.ChannelTypeCodex,
+			model:       "gpt-5",
+			configure: func(info *relaycommon.RelayInfo) {
+				info.ChannelSetting.SystemPrompt = "channel system prompt"
+				info.ChannelSetting.SystemPromptOverride = true
+			},
+			validate: func(t *testing.T, converted dto.OpenAIResponsesRequest) {
+				t.Helper()
+				require.JSONEq(t, `"channel system prompt\noriginal instructions"`, string(converted.Instructions))
+				require.JSONEq(t, `false`, string(converted.Store))
+				require.Nil(t, converted.MaxOutputTokens)
+				require.Nil(t, converted.Temperature)
+			},
+		},
+		{
+			name:        "AdvancedCustom",
+			apiType:     constant.APITypeAdvancedCustom,
+			channelType: constant.ChannelTypeAdvancedCustom,
+			model:       "gpt-5-high",
+			configure: func(info *relaycommon.RelayInfo) {
+				info.ChannelOtherSettings.AdvancedCustom = &dto.AdvancedCustomConfig{
+					Routes: []dto.AdvancedCustomRoute{
+						{
+							IncomingPath: "/v1/responses",
+							UpstreamPath: "/v1/responses",
+							Converter:    relayconvert.ConverterNone,
+						},
+					},
+				}
+			},
+			validate: reasoningSuffixValidation("gpt-5", "high"),
+		},
+		{name: "Sub2API", apiType: constant.APITypeSub2API, channelType: constant.ChannelTypeSub2API, model: "gpt-5"},
+		{name: "NewAPI", apiType: constant.APITypeNewAPI, channelType: constant.ChannelTypeNewAPI, model: "gpt-5"},
+		{name: "xAI", apiType: constant.APITypeXai, channelType: constant.ChannelTypeXai, model: "grok-4"},
+		{name: "Ali", apiType: constant.APITypeAli, channelType: constant.ChannelTypeAli, model: "qwen-plus"},
+		{name: "Cloudflare", apiType: constant.APITypeCloudflare, channelType: constant.ChannelCloudflare, model: "gpt-5"},
+		{name: "Perplexity", apiType: constant.APITypePerplexity, channelType: constant.ChannelTypePerplexity, model: "sonar"},
+		{name: "VolcEngine", apiType: constant.APITypeVolcEngine, channelType: constant.ChannelTypeVolcEngine, model: "doubao-seed"},
+	}
+}
+
+func TestRawResponsesAdaptorsPreserveCanonicalOwnership(t *testing.T) {
+	cases := rawResponsesAdaptorContractCases()
+	testedAPITypes := make(map[int]struct{}, len(cases))
+	for _, testCase := range cases {
+		testCase := testCase
+		t.Run(testCase.name, func(t *testing.T) {
+			require.True(t, supportsRawResponsesAPIType(testCase.apiType))
+			if _, duplicate := testedAPITypes[testCase.apiType]; duplicate {
+				t.Fatalf("API type %d has duplicate ownership test cases", testCase.apiType)
+			}
+			testedAPITypes[testCase.apiType] = struct{}{}
+
+			canonical := responsesAdaptorOwnershipFixture(testCase.model)
+			before, err := common.DeepCopy(canonical)
+			require.NoError(t, err)
+			requireResponsesOwnershipSnapshotIndependent(t, canonical, before)
+
+			convertedRequest := convertRawResponsesAdaptorContractCase(t, testCase, canonical)
+			if testCase.validate != nil {
+				testCase.validate(t, convertedRequest)
+			}
+
+			require.Equal(t, *before, *canonical, "adaptor mutated the canonical Responses request")
+		})
+	}
+
+	for apiType := 0; apiType < constant.APITypeDummy; apiType++ {
+		if supportsRawResponsesAPIType(apiType) {
+			_, covered := testedAPITypes[apiType]
+			require.True(t, covered, "raw Responses API type %d is missing an ownership contract test", apiType)
+		}
+	}
+}
+
+// This guards the adaptor mutation field set, not the patch-count threshold or
+// whether a particular request ultimately takes the raw path.
+func TestRawResponsesAdaptorsKeepMutationsAudited(t *testing.T) {
+	for _, testCase := range rawResponsesAdaptorContractCases() {
+		testCase := testCase
+		t.Run(testCase.name, func(t *testing.T) {
+			canonical := responsesAdaptorOwnershipFixture(testCase.model)
+			convertedRequest := convertRawResponsesAdaptorContractCase(t, testCase, canonical)
+
+			_, audited, err := buildResponsesJSONPatches(canonical, &convertedRequest)
+			require.NoError(t, err)
+			require.True(t, audited,
+				"adaptor changed a field outside the audited patch set; typed fallback preserves correctness, but raw eligibility must be reviewed",
+			)
+		})
+	}
+}
+
+func convertRawResponsesAdaptorContractCase(
+	t *testing.T,
+	testCase rawResponsesAdaptorContractCase,
+	canonical *dto.OpenAIResponsesRequest,
+) dto.OpenAIResponsesRequest {
+	t.Helper()
+	attempt, err := cloneOpenAIResponsesAttempt(canonical)
+	require.NoError(t, err)
+
+	info := responsesAdaptorOwnershipRelayInfo(testCase.apiType, testCase.channelType, testCase.model)
+	if testCase.configure != nil {
+		testCase.configure(info)
+	}
+	adaptor := GetAdaptor(testCase.apiType)
+	require.NotNil(t, adaptor)
+	adaptor.Init(info)
+
+	converted, err := adaptor.ConvertOpenAIResponsesRequest(responsesAdaptorOwnershipContext(), info, *attempt)
+	require.NoError(t, err)
+	convertedRequest, ok := openAIResponsesRequestValue(converted)
+	require.True(t, ok, "raw Responses adaptor returned %T", converted)
+	return convertedRequest
+}
+
+func requireResponsesOwnershipSnapshotIndependent(
+	t *testing.T,
+	canonical *dto.OpenAIResponsesRequest,
+	snapshot *dto.OpenAIResponsesRequest,
+) {
+	t.Helper()
+	require.NotSame(t, canonical, snapshot)
+	require.NotSame(t, canonical.Reasoning, snapshot.Reasoning)
+	require.NotSame(t, canonical.MaxOutputTokens, snapshot.MaxOutputTokens)
+	require.NotSame(t, canonical.Temperature, snapshot.Temperature)
+	require.NotSame(t, canonical.StreamOptions, snapshot.StreamOptions)
+	require.NotSame(t, &canonical.Input[0], &snapshot.Input[0])
+	require.NotSame(t, &canonical.Tools[0], &snapshot.Tools[0])
+	require.NotSame(t, &canonical.Reasoning.Mode[0], &snapshot.Reasoning.Mode[0])
+	require.NotSame(t, &canonical.Reasoning.Context[0], &snapshot.Reasoning.Context[0])
+}
+
+func responsesAdaptorOwnershipFixture(model string) *dto.OpenAIResponsesRequest {
+	maxOutputTokens := uint(4096)
+	topLogProbs := 5
+	stream := true
+	temperature := 0.7
+	topP := 0.9
+	maxToolCalls := uint(8)
+	return &dto.OpenAIResponsesRequest{
+		Model:                model,
+		Input:                json.RawMessage(`[{"role":"user","content":[{"type":"input_text","text":"hello"}]}]`),
+		Include:              json.RawMessage(`["reasoning.encrypted_content"]`),
+		Conversation:         json.RawMessage(`{"id":"conv_test"}`),
+		ContextManagement:    json.RawMessage(`[{"type":"compaction","compact_threshold":1000}]`),
+		Instructions:         json.RawMessage(`"original instructions"`),
+		MaxOutputTokens:      &maxOutputTokens,
+		TopLogProbs:          &topLogProbs,
+		Metadata:             json.RawMessage(`{"trace":"ownership"}`),
+		Moderation:           json.RawMessage(`{"level":"standard"}`),
+		ParallelToolCalls:    json.RawMessage(`true`),
+		PreviousResponseID:   "resp_previous",
+		Reasoning:            &dto.Reasoning{Effort: "medium", Summary: "auto", Mode: json.RawMessage(`{"type":"enabled"}`), Context: json.RawMessage(`{"encrypted":"context"}`)},
+		ServiceTier:          "default",
+		Store:                json.RawMessage(`true`),
+		PromptCacheKey:       json.RawMessage(`"cache-key"`),
+		PromptCacheOptions:   json.RawMessage(`{"type":"ephemeral"}`),
+		PromptCacheRetention: json.RawMessage(`"24h"`),
+		SafetyIdentifier:     json.RawMessage(`"user-test"`),
+		Stream:               &stream,
+		StreamOptions:        &dto.StreamOptions{IncludeUsage: true, IncludeObfuscation: true},
+		Temperature:          &temperature,
+		Text:                 json.RawMessage(`{"format":{"type":"text"}}`),
+		ToolChoice:           json.RawMessage(`"auto"`),
+		Tools:                json.RawMessage(`[{"type":"function","name":"lookup","parameters":{"type":"object"}}]`),
+		TopP:                 &topP,
+		Truncation:           json.RawMessage(`"auto"`),
+		User:                 json.RawMessage(`"legacy-user"`),
+		MaxToolCalls:         &maxToolCalls,
+		Prompt:               json.RawMessage(`{"id":"pmpt_test"}`),
+		ClientMetadata:       json.RawMessage(`{"client":"codex"}`),
+		EnableThinking:       json.RawMessage(`true`),
+		ThinkingBudget:       json.RawMessage(`1024`),
+		Preset:               json.RawMessage(`"pro-search"`),
+	}
+}
+
+func responsesAdaptorOwnershipRelayInfo(apiType, channelType int, model string) *relaycommon.RelayInfo {
+	return &relaycommon.RelayInfo{
+		OriginModelName: model,
+		RequestURLPath:  "/v1/responses",
+		RelayMode:       relayconstant.RelayModeResponses,
+		RelayFormat:     types.RelayFormatOpenAIResponses,
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ApiType:           apiType,
+			ChannelType:       channelType,
+			ChannelBaseUrl:    "https://upstream.example",
+			ApiKey:            "test-key",
+			UpstreamModelName: model,
+		},
+	}
+}
+
+func responsesAdaptorOwnershipContext() *gin.Context {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+	return c
+}
