new file mode 100644
index 00000000..69ae02c2
--- /dev/null
+++ b/relay/responses_request_clone.go
@@ -0,0 +1,24 @@
+package relay
+
+import (
+	"errors"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+)
+
+// cloneOpenAIResponsesAttempt creates the attempt-local ownership required by
+// Responses adaptors. The request contains many large RawMessage values; the
+// current adaptor contract only mutates the Reasoning struct in place, so
+// copying every nested value would recreate the cost of DeepCopy.
+func cloneOpenAIResponsesAttempt(src *dto.OpenAIResponsesRequest) (*dto.OpenAIResponsesRequest, error) {
+	if src == nil {
+		return nil, errors.New("copy source cannot be nil")
+	}
+
+	dst := *src
+	if src.Reasoning != nil {
+		reasoning := *src.Reasoning
+		dst.Reasoning = &reasoning
+	}
+	return &dst, nil
+}
