new file mode 100644
index 00000000..c2c84c05
--- /dev/null
+++ b/relay/responses_body.go
@@ -0,0 +1,481 @@
+package relay
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+	"unicode/utf8"
+	"unsafe"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// responsesBodyPlan retains the original storage only while the resulting JSON
+// still aliases its bytes. The caller decides whether to borrow that storage
+// after field filtering and parameter overrides have completed.
+type responsesBodyPlan struct {
+	data      []byte
+	canonical []byte
+	storage   common.BodyStorage
+}
+
+type responsesJSONPatch struct {
+	key    string
+	value  []byte
+	delete bool
+}
+
+var responsesRequestJSONFields = responsesJSONFieldNames(reflect.TypeOf(dto.OpenAIResponsesRequest{}))
+
+// responsesRawBodyMinBytes is a performance threshold, not a wire-format
+// contract. Smaller bodies use the typed encoder, while eligible larger bodies
+// may preserve the client's field order, whitespace, escapes, and numeric
+// spelling. Both paths guarantee JSON semantic equivalence only; channels that
+// require byte-for-byte request-body identity must enable request pass-through,
+// which intentionally bypasses conversion, field filtering, and param override.
+const responsesRawBodyMinBytes = 4 << 10
+
+// planResponsesRequestBody keeps the existing DTO encoder as the correctness
+// fallback. The raw path is limited to a value-shaped Responses request whose
+// adapter changes are known and whose input already has the DTO's JSON shape.
+func planResponsesRequestBody(
+	c *gin.Context,
+	info *relaycommon.RelayInfo,
+	source *dto.OpenAIResponsesRequest,
+	converted any,
+) (responsesBodyPlan, error) {
+	convertedRequest, ok := openAIResponsesRequestValue(converted)
+	if !ok || info == nil || info.RelayMode != relayconstant.RelayModeResponses ||
+		source == nil || !supportsRawResponsesAPIType(info.ApiType) {
+		return marshalResponsesBodyPlan(converted)
+	}
+
+	storage, storageErr := common.GetBodyStorage(c)
+	if storageErr != nil || storage == nil || storage.IsDisk() {
+		return marshalResponsesBodyPlan(converted)
+	}
+	canonical, err := storage.Bytes()
+	if err != nil || len(canonical) < responsesRawBodyMinBytes {
+		return marshalResponsesBodyPlan(converted)
+	}
+
+	patches, ok, err := buildResponsesJSONPatches(source, &convertedRequest)
+	if err != nil {
+		// Marshal remains the source of truth for invalid RawMessage values and
+		// any future adaptor change not represented by the patch planner.
+		return marshalResponsesBodyPlan(converted)
+	}
+	if !ok || len(patches) > 1 {
+		// SJSON creates a new body for the first change and for later deletes or
+		// insertions. Beyond one top-level change, the typed encoder has the more
+		// predictable peak-memory profile.
+		return marshalResponsesBodyPlan(converted)
+	}
+	// OpenAIResponsesRequest.MarshalJSON drops thinking_budget for every model
+	// family except Qwen. Count that deletion before selecting the raw path.
+	if !dto.IsQwenThinkingBudgetModel(convertedRequest.Model) && gjson.GetBytes(canonical, "thinking_budget").Exists() {
+		patches = append(patches, responsesJSONPatch{key: "thinking_budget", delete: true})
+		if len(patches) > 1 {
+			return marshalResponsesBodyPlan(converted)
+		}
+	}
+	if !responsesRawShapeCompatible(canonical, source) {
+		return marshalResponsesBodyPlan(converted)
+	}
+
+	data, err := applyResponsesJSONPatches(canonical, patches)
+	if err != nil {
+		return marshalResponsesBodyPlan(converted)
+	}
+	return responsesBodyPlan{data: data, canonical: canonical, storage: storage}, nil
+}
+
+func marshalResponsesBodyPlan(value any) (responsesBodyPlan, error) {
+	data, err := common.Marshal(value)
+	return responsesBodyPlan{data: data}, err
+}
+
+// New or unaudited adaptors default to the typed encoder. Raw-compatible
+// adaptors must treat shared RawMessage backing bytes and pointer pointees as
+// read-only, replacing whole fields instead of mutating shared storage. The
+// fast patch set is Model, Instructions, MaxOutputTokens, Reasoning, Store, and
+// Temperature; replacing any other field remains correct but forces the typed
+// fallback until buildResponsesJSONPatches is updated. Keep this list aligned
+// with TestRawResponsesAdaptorsPreserveCanonicalOwnership and
+// TestRawResponsesAdaptorsKeepMutationsAudited.
+func supportsRawResponsesAPIType(apiType int) bool {
+	switch apiType {
+	case constant.APITypeOpenAI,
+		constant.APITypeOpenRouter,
+		constant.APITypeXinference,
+		constant.APITypeDeepSeek,
+		constant.APITypeCodex,
+		constant.APITypeAdvancedCustom,
+		constant.APITypeSub2API,
+		constant.APITypeNewAPI,
+		constant.APITypeXai,
+		constant.APITypeAli,
+		constant.APITypeCloudflare,
+		constant.APITypePerplexity,
+		constant.APITypeVolcEngine:
+		return true
+	default:
+		return false
+	}
+}
+
+func openAIResponsesRequestValue(value any) (dto.OpenAIResponsesRequest, bool) {
+	switch request := value.(type) {
+	case dto.OpenAIResponsesRequest:
+		return request, true
+	case *dto.OpenAIResponsesRequest:
+		if request != nil {
+			return *request, true
+		}
+	}
+	return dto.OpenAIResponsesRequest{}, false
+}
+
+// buildResponsesJSONPatches returns ok=false when a future or unsupported
+// adaptor mutation must use the standard DTO encoder instead of silently
+// sending a stale raw field.
+func buildResponsesJSONPatches(
+	source *dto.OpenAIResponsesRequest,
+	converted *dto.OpenAIResponsesRequest,
+) ([]responsesJSONPatch, bool, error) {
+	if source == nil || converted == nil {
+		return nil, false, nil
+	}
+
+	candidate := *source
+	// These are the only fields currently changed by Responses adaptors:
+	// model mapping/reasoning suffixes, Codex instruction/store filtering, and
+	// Codex removal of max_output_tokens/temperature.
+	candidate.Model = converted.Model
+	candidate.Instructions = converted.Instructions
+	candidate.MaxOutputTokens = converted.MaxOutputTokens
+	candidate.Reasoning = converted.Reasoning
+	candidate.Store = converted.Store
+	candidate.Temperature = converted.Temperature
+	if !reflect.DeepEqual(candidate, *converted) {
+		return nil, false, nil
+	}
+
+	patches := make([]responsesJSONPatch, 0, 4)
+	if source.Model != converted.Model {
+		value, err := common.Marshal(converted.Model)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, responsesJSONPatch{key: "model", value: value})
+	}
+	if !bytes.Equal(source.Instructions, converted.Instructions) {
+		patch, err := rawMessagePatch("instructions", converted.Instructions)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, patch)
+	}
+	if !responsesUintPointerEqual(source.MaxOutputTokens, converted.MaxOutputTokens) {
+		patch, err := pointerPatch("max_output_tokens", converted.MaxOutputTokens)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, patch)
+	}
+	if !reflect.DeepEqual(source.Reasoning, converted.Reasoning) {
+		patch, err := pointerPatch("reasoning", converted.Reasoning)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, patch)
+	}
+	if !bytes.Equal(source.Store, converted.Store) {
+		patch, err := rawMessagePatch("store", converted.Store)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, patch)
+	}
+	if !responsesFloatPointerEqual(source.Temperature, converted.Temperature) {
+		patch, err := pointerPatch("temperature", converted.Temperature)
+		if err != nil {
+			return nil, false, err
+		}
+		patches = append(patches, patch)
+	}
+
+	return patches, true, nil
+}
+
+func rawMessagePatch(key string, value json.RawMessage) (responsesJSONPatch, error) {
+	if len(value) == 0 {
+		return responsesJSONPatch{key: key, delete: true}, nil
+	}
+	encoded, err := common.Marshal(value)
+	if err != nil {
+		return responsesJSONPatch{}, err
+	}
+	return responsesJSONPatch{key: key, value: encoded}, nil
+}
+
+func pointerPatch[T any](key string, value *T) (responsesJSONPatch, error) {
+	if value == nil {
+		return responsesJSONPatch{key: key, delete: true}, nil
+	}
+	encoded, err := common.Marshal(value)
+	if err != nil {
+		return responsesJSONPatch{}, err
+	}
+	return responsesJSONPatch{key: key, value: encoded}, nil
+}
+
+func responsesUintPointerEqual(left, right *uint) bool {
+	if left == nil || right == nil {
+		return left == nil && right == nil
+	}
+	return *left == *right
+}
+
+func responsesFloatPointerEqual(left, right *float64) bool {
+	if left == nil || right == nil {
+		return left == nil && right == nil
+	}
+	return *left == *right
+}
+
+func applyResponsesJSONPatches(canonical []byte, patches []responsesJSONPatch) ([]byte, error) {
+	// canonical may be the BodyStorage backing buffer. Keep the first patch
+	// non-in-place so result owns a separate buffer before any ReplaceInPlace
+	// optimization is considered. Never enable ReplaceInPlace while owned is
+	// false: doing so would mutate the original request and poison retries.
+	result := canonical
+	owned := false
+	for _, patch := range patches {
+		path := responsesJSONLiteralPath(patch.key)
+		var err error
+		if patch.delete {
+			if !gjson.GetBytes(result, path).Exists() {
+				continue
+			}
+			result, err = sjson.DeleteBytes(result, path)
+			owned = true
+		} else if owned && gjson.GetBytes(result, path).Exists() {
+			// Only an attempt-owned buffer may be modified in place.
+			result, err = sjson.SetRawBytesOptions(result, path, patch.value, &sjson.Options{
+				Optimistic:     true,
+				ReplaceInPlace: true,
+			})
+		} else {
+			result, err = sjson.SetRawBytes(result, path, patch.value)
+			owned = true
+		}
+		if err != nil {
+			return nil, fmt.Errorf("patch Responses field %q: %w", patch.key, err)
+		}
+	}
+	return result, nil
+}
+
+func responsesJSONLiteralPath(key string) string {
+	var escaped strings.Builder
+	escaped.Grow(len(key) + 1)
+	for i := 0; i < len(key); i++ {
+		if strings.ContainsRune(".*?#@|\\", rune(key[i])) || (i == 0 && key[i] == ':') {
+			escaped.WriteByte('\\')
+		}
+		escaped.WriteByte(key[i])
+	}
+	return escaped.String()
+}
+
+func responsesJSONSharesStorage(left, right []byte) bool {
+	return len(left) == len(right) && (len(left) == 0 || &left[0] == &right[0])
+}
+
+// responsesRawShapeCompatible rejects cases where standard encoding/json would
+// change presence or structure. RawMessage subtrees are intentionally opaque;
+// their contents are preserved by the DTO and need no recursive inspection.
+func responsesRawShapeCompatible(data []byte, source *dto.OpenAIResponsesRequest) bool {
+	if source == nil {
+		return false
+	}
+	if !json.Valid(data) || !utf8.Valid(data) {
+		return false
+	}
+	root := gjson.Parse(responsesReadOnlyBytesString(data))
+	if !root.IsObject() {
+		return false
+	}
+	keys := make(map[string]gjson.Result, len(responsesRequestJSONFields))
+	valid := true
+	root.ForEach(func(key, value gjson.Result) bool {
+		name := key.String()
+		if _, duplicate := keys[name]; duplicate {
+			valid = false
+			return false
+		}
+		if _, known := responsesRequestJSONFields[name]; !known {
+			valid = false
+			return false
+		}
+		keys[name] = value
+		return true
+	})
+	if !valid {
+		return false
+	}
+	model, modelExists := keys["model"]
+	if !modelExists || model.Type != gjson.String || model.String() != source.Model {
+		return false
+	}
+
+	value := reflect.ValueOf(*source)
+	typeOfRequest := value.Type()
+	for i := 0; i < typeOfRequest.NumField(); i++ {
+		field := typeOfRequest.Field(i)
+		name, omitempty, skip := responsesJSONFieldTag(field)
+		if skip || name == "" {
+			continue
+		}
+		fieldValue := value.Field(i)
+		present := false
+		if _, exists := keys[name]; exists {
+			present = true
+		}
+		if omitempty && responsesJSONEmptyValue(fieldValue) {
+			if present {
+				return false
+			}
+			continue
+		}
+		if !present {
+			return false
+		}
+	}
+
+	if source.Reasoning != nil && !responsesRawNestedShapeCompatible(keys["reasoning"], reflect.ValueOf(*source.Reasoning)) {
+		return false
+	}
+	if source.StreamOptions != nil && !responsesRawNestedShapeCompatible(keys["stream_options"], reflect.ValueOf(*source.StreamOptions)) {
+		return false
+	}
+	return true
+}
+
+// responsesReadOnlyBytesString avoids copying a large request solely for
+// GJSON's synchronous shape scan. It is intentionally used only as the
+// immediate input to gjson.Parse in responsesRawShapeCompatible. Neither this
+// string nor a gjson.Result derived from it may escape that synchronous call or
+// be retained after it returns; the backing bytes must remain alive and
+// immutable throughout responsesRawShapeCompatible.
+func responsesReadOnlyBytesString(data []byte) string {
+	if len(data) == 0 {
+		return ""
+	}
+	return unsafe.String(unsafe.SliceData(data), len(data))
+}
+
+func responsesRawNestedShapeCompatible(value gjson.Result, decoded reflect.Value) bool {
+	if !value.Exists() || !value.IsObject() {
+		return false
+	}
+	typ := decoded.Type()
+	known := responsesJSONFieldNames(typ)
+	seen := make(map[string]gjson.Result, len(known))
+	valid := true
+	value.ForEach(func(key, child gjson.Result) bool {
+		name := key.String()
+		if _, duplicate := seen[name]; duplicate {
+			valid = false
+			return false
+		}
+		if _, ok := known[name]; !ok {
+			valid = false
+			return false
+		}
+		seen[name] = child
+		return true
+	})
+	if !valid {
+		return false
+	}
+	for i := 0; i < typ.NumField(); i++ {
+		field := typ.Field(i)
+		name, omitempty, skip := responsesJSONFieldTag(field)
+		if skip || name == "" {
+			continue
+		}
+		fieldValue := decoded.Field(i)
+		_, present := seen[name]
+		if omitempty && responsesJSONEmptyValue(fieldValue) {
+			if present {
+				return false
+			}
+			continue
+		}
+		if !present {
+			return false
+		}
+	}
+	return true
+}
+
+func responsesJSONFieldNames(typ reflect.Type) map[string]struct{} {
+	fields := make(map[string]struct{}, typ.NumField())
+	for i := 0; i < typ.NumField(); i++ {
+		name, _, skip := responsesJSONFieldTag(typ.Field(i))
+		if !skip && name != "" {
+			fields[name] = struct{}{}
+		}
+	}
+	return fields
+}
+
+func responsesJSONFieldTag(field reflect.StructField) (name string, omitempty bool, skip bool) {
+	tag := field.Tag.Get("json")
+	if tag == "-" {
+		return "", false, true
+	}
+	parts := strings.Split(tag, ",")
+	if len(parts) == 0 || parts[0] == "" {
+		return field.Name, false, false
+	}
+	for _, option := range parts[1:] {
+		if option == "omitempty" {
+			omitempty = true
+		}
+	}
+	return parts[0], omitempty, false
+}
+
+func responsesJSONEmptyValue(value reflect.Value) bool {
+	if !value.IsValid() {
+		return true
+	}
+	switch value.Kind() {
+	case reflect.Array, reflect.Map, reflect.Slice, reflect.String:
+		return value.Len() == 0
+	case reflect.Bool:
+		return !value.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return value.Int() == 0
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return value.Uint() == 0
+	case reflect.Float32, reflect.Float64:
+		return value.Float() == 0
+	case reflect.Interface, reflect.Pointer:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
