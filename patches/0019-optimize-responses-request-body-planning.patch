+package relay
+
+import (
+	"bytes"
+	"encoding/json"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/stretchr/testify/require"
+)
+
+var benchmarkResponsesRequestSink *dto.OpenAIResponsesRequest
+
+func TestCloneOpenAIResponsesAttemptIsolatesReasoning(t *testing.T) {
+	source := cloneResponsesFixture(1024)
+
+	clone, err := cloneOpenAIResponsesAttempt(source)
+	require.NoError(t, err)
+	require.Equal(t, source, clone)
+	require.NotSame(t, source, clone)
+	require.NotSame(t, source.Reasoning, clone.Reasoning)
+
+	clone.Model = "gpt-5.2"
+	clone.Reasoning.Effort = "high"
+	clone.Reasoning.Summary = "detailed"
+
+	require.Equal(t, "gpt-5.1", source.Model)
+	require.Equal(t, "medium", source.Reasoning.Effort)
+	require.Equal(t, "auto", source.Reasoning.Summary)
+}
+
+func TestCloneOpenAIResponsesAttemptSharesReadOnlyFields(t *testing.T) {
+	source := cloneResponsesFixture(1024)
+
+	clone, err := cloneOpenAIResponsesAttempt(source)
+	require.NoError(t, err)
+
+	requireSlicesAlias(t, source.Input, clone.Input)
+	requireSlicesAlias(t, source.Tools, clone.Tools)
+	requireSlicesAlias(t, source.Instructions, clone.Instructions)
+	requireSlicesAlias(t, source.Reasoning.Mode, clone.Reasoning.Mode)
+	requireSlicesAlias(t, source.Reasoning.Context, clone.Reasoning.Context)
+	require.Same(t, source.MaxOutputTokens, clone.MaxOutputTokens)
+	require.Same(t, source.Temperature, clone.Temperature)
+	require.Same(t, source.StreamOptions, clone.StreamOptions)
+}
+
+func TestCloneOpenAIResponsesAttemptKeepsNilReasoning(t *testing.T) {
+	source := cloneResponsesFixture(0)
+	source.Reasoning = nil
+
+	clone, err := cloneOpenAIResponsesAttempt(source)
+	require.NoError(t, err)
+	require.Nil(t, clone.Reasoning)
+	require.Equal(t, source, clone)
+}
+
+func TestCloneOpenAIResponsesAttemptRejectsNil(t *testing.T) {
+	clone, err := cloneOpenAIResponsesAttempt(nil)
+
+	require.Nil(t, clone)
+	require.EqualError(t, err, "copy source cannot be nil")
+}
+
+func BenchmarkCloneOpenAIResponsesAttempt(b *testing.B) {
+	for _, size := range []int{1024, 200 * 1024} {
+		source := cloneResponsesFixture(size)
+		name := byteSizeName(size)
+
+		b.Run(name+"/attempt_clone", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				clone, err := cloneOpenAIResponsesAttempt(source)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesRequestSink = clone
+			}
+		})
+
+		b.Run(name+"/reflection_deep_copy", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				clone, err := common.DeepCopy(source)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesRequestSink = clone
+			}
+		})
+	}
+}
+
+func cloneResponsesFixture(payloadSize int) *dto.OpenAIResponsesRequest {
+	payload := strings.Repeat("x", payloadSize)
+	maxOutputTokens := uint(4096)
+	temperature := 0.25
+	stream := true
+	return &dto.OpenAIResponsesRequest{
+		Model:           "gpt-5.1",
+		Input:           mustJSONRawMessage(payload),
+		Instructions:    json.RawMessage(`"be concise"`),
+		MaxOutputTokens: &maxOutputTokens,
+		Reasoning: &dto.Reasoning{
+			Effort:  "medium",
+			Summary: "auto",
+			Mode:    json.RawMessage(`{"type":"enabled"}`),
+			Context: json.RawMessage(`{"encrypted":"context"}`),
+		},
+		Store:         json.RawMessage(`true`),
+		Stream:        &stream,
+		StreamOptions: &dto.StreamOptions{IncludeUsage: true, IncludeObfuscation: true},
+		Temperature:   &temperature,
+		Tools:         json.RawMessage(`[{"type":"function","name":"lookup"}]`),
+	}
+}
+
+func mustJSONRawMessage(value string) json.RawMessage {
+	data, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	return data
+}
+
+func requireSlicesAlias(t *testing.T, left, right []byte) {
+	t.Helper()
+	require.Equal(t, left, right)
+	if len(left) == 0 {
+		require.Empty(t, right)
+		return
+	}
+	require.True(t, bytes.Equal(left, right))
+	require.True(t, &left[0] == &right[0], "expected read-only byte slices to share storage")
+}
+
+func byteSizeName(size int) string {
+	if size >= 1024 {
+		return strconv.Itoa(size/1024) + "KiB"
+	}
+	return strconv.Itoa(size) + "B"
+}
