+				{key: "model", value: []byte(`"gpt-5"`)},
+			},
+			want: `{"model":"gpt-5","input":[]}`,
+		},
+		{
+			name: "missing first deletion keeps canonical borrowed",
+			patches: []responsesJSONPatch{
+				{key: "missing", delete: true},
+				{key: "model", value: []byte(`"gpt-5"`)},
+			},
+			want: `{"model":"gpt-5","input":[],"store":true}`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			canonical := []byte(`{"model":"gpt-5-high","input":[],"store":true}`)
+			before := bytes.Clone(canonical)
+
+			result, err := applyResponsesJSONPatches(canonical, tt.patches)
+			require.NoError(t, err)
+			require.Equal(t, before, canonical, "patching must never mutate canonical storage")
+			require.NotSame(t, &canonical[0], &result[0], "patched output must own its buffer")
+			require.JSONEq(t, tt.want, string(result))
+		})
+	}
+}
+
+func TestPlanResponsesRequestBodyReturnsMarshalErrorForInvalidRawMessage(t *testing.T) {
+	tests := []struct {
+		name           string
+		wantBuildError bool
+		mutate         func(*dto.OpenAIResponsesRequest)
+	}{
+		{
+			name:           "audited raw field",
+			wantBuildError: true,
+			mutate: func(request *dto.OpenAIResponsesRequest) {
+				request.Instructions = json.RawMessage(`{`)
+			},
+		},
+		{
+			name: "unsupported raw field",
+			mutate: func(request *dto.OpenAIResponsesRequest) {
+				request.Input = json.RawMessage(`{`)
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			raw := padResponsesPlanJSON(t, `{"model":"gpt-5","input":[]}`)
+			c, source, storage, before := newResponsesPlanFixture(t, raw, false)
+			requireResponsesRawShapeEligible(t, raw, source)
+			sourceBefore := marshalResponsesSource(t, source)
+			converted := *source
+			tt.mutate(&converted)
+			_, ok, buildErr := buildResponsesJSONPatches(source, &converted)
+			if tt.wantBuildError {
+				require.Error(t, buildErr)
+			} else {
+				require.NoError(t, buildErr)
+				require.False(t, ok)
+			}
+
+			plan, err := planResponsesRequestBody(c, responsesPlanInfo(constant.APITypeOpenAI, relayconstant.RelayModeResponses), source, converted)
+			require.Error(t, err)
+			require.Empty(t, plan.data)
+			require.Nil(t, plan.storage)
+			requireResponsesFixtureUnchanged(t, storage, before, source, sourceBefore)
+		})
+	}
+}
+
+func BenchmarkPlanResponsesRequestBody(b *testing.B) {
+	for _, size := range []int{1024, 2 * 1024, 4 * 1024, 8 * 1024, 32 * 1024, 200 * 1024} {
+		raw := []byte(`{"model":"gpt-5","input":"` + strings.Repeat("x", size) + `","max_output_tokens":4096,"reasoning":{"effort":"medium"},"store":true,"temperature":0.25}`)
+		var source dto.OpenAIResponsesRequest
+		if err := common.Unmarshal(raw, &source); err != nil {
+			b.Fatal(err)
+		}
+		storage := &responsesPlanStorage{Reader: bytes.NewReader(raw), data: raw}
+		c, _ := gin.CreateTestContext(httptest.NewRecorder())
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(raw))
+		c.Request.Header.Set("Content-Type", "application/json")
+		c.Set(common.KeyBodyStorage, storage)
+		info := responsesPlanInfo(constant.APITypeOpenAI, relayconstant.RelayModeResponses)
+
+		b.Run(byteSizeName(size)+"/planner_noop", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				plan, err := planResponsesRequestBody(c, info, &source, source)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesBodySink = plan.data
+			}
+		})
+
+		b.Run(byteSizeName(size)+"/typed_marshal", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				data, err := common.Marshal(&source)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesBodySink = data
+			}
+		})
+
+		modelConverted := source
+		modelConverted.Model = "gpt-5-upstream"
+		b.Run(byteSizeName(size)+"/planner_model_patch", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				plan, err := planResponsesRequestBody(c, info, &source, modelConverted)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesBodySink = plan.data
+			}
+		})
+
+		converted := source
+		converted.Instructions = json.RawMessage(`""`)
+		converted.MaxOutputTokens = nil
+		converted.Store = json.RawMessage(`false`)
+		converted.Temperature = nil
+		codexInfo := responsesPlanInfo(constant.APITypeCodex, relayconstant.RelayModeResponses)
+		b.Run(byteSizeName(size)+"/planner_codex_multi_patch", func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				plan, err := planResponsesRequestBody(c, codexInfo, &source, converted)
+				if err != nil {
+					b.Fatal(err)
+				}
+				benchmarkResponsesBodySink = plan.data
+			}
+		})
+	}
+}
+
+type responsesPlanStorage struct {
+	*bytes.Reader
+	data []byte
+	disk bool
+}
+
+func padResponsesPlanJSON(t *testing.T, raw string) string {
+	t.Helper()
+	padded, err := sjson.Set(raw, "metadata.scheme3_padding", strings.Repeat("x", responsesRawBodyMinBytes))
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, len(padded), responsesRawBodyMinBytes)
+	return padded
+}
+
+func requireResponsesRawShapeEligible(t *testing.T, raw string, source *dto.OpenAIResponsesRequest) {
+	t.Helper()
+	require.GreaterOrEqual(t, len(raw), responsesRawBodyMinBytes)
+	require.True(t, responsesRawShapeCompatible([]byte(raw), source))
+}
+
+func (s *responsesPlanStorage) Bytes() ([]byte, error) {
+	return s.data, nil
+}
+
+func (s *responsesPlanStorage) Size() int64 {
+	return int64(len(s.data))
+}
+
+func (s *responsesPlanStorage) IsDisk() bool {
+	return s.disk
+}
+
+func (s *responsesPlanStorage) Close() error {
+	return nil
+}
+
+func newResponsesPlanFixture(t *testing.T, raw string, disk bool) (*gin.Context, *dto.OpenAIResponsesRequest, *responsesPlanStorage, []byte) {
+	t.Helper()
+
+	data := make([]byte, len(raw), len(raw)+1024)
+	copy(data, raw)
+	var source dto.OpenAIResponsesRequest
+	require.NoError(t, common.Unmarshal(data, &source))
+
+	storage := &responsesPlanStorage{
+		Reader: bytes.NewReader(data),
+		data:   data,
+		disk:   disk,
+	}
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(data))
+	c.Request.Header.Set("Content-Type", "application/json")
+	c.Set(common.KeyBodyStorage, storage)
+	return c, &source, storage, bytes.Clone(data)
+}
+
+func responsesPlanInfo(apiType, relayMode int) *relaycommon.RelayInfo {
+	return &relaycommon.RelayInfo{
+		RelayMode: relayMode,
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ApiType: apiType,
+		},
+	}
+}
+
+func marshalResponsesSource(t *testing.T, source *dto.OpenAIResponsesRequest) []byte {
+	t.Helper()
+	data, err := common.Marshal(source)
+	require.NoError(t, err)
+	return data
+}
+
+func requireResponsesFixtureUnchanged(
+	t *testing.T,
+	storage *responsesPlanStorage,
+	canonicalBefore []byte,
+	source *dto.OpenAIResponsesRequest,
+	sourceBefore []byte,
+) {
+	t.Helper()
+	require.Equal(t, canonicalBefore, storage.data, "planner mutated canonical request bytes")
+	require.Equal(t, sourceBefore, marshalResponsesSource(t, source), "planner mutated source DTO")
+	position, err := storage.Seek(0, io.SeekCurrent)
+	require.NoError(t, err)
+	require.Equal(t, int64(0), position, "planner left canonical storage at a different offset")
+}
+
+func requireTypedResponsesFallback(t *testing.T, plan responsesBodyPlan) {
+	t.Helper()
+	require.Nil(t, plan.storage)
+	require.Nil(t, plan.canonical)
+}
