+	t *testing.T,
+	raw []byte,
+) (*gin.Context, *relaycommon.RelayInfo, *scheme3TrackingBodyStorage, dto.OpenAIResponsesRequest) {
+	t.Helper()
+
+	var canonical dto.OpenAIResponsesRequest
+	require.NoError(t, common.Unmarshal(raw, &canonical))
+	var wantCanonical dto.OpenAIResponsesRequest
+	require.NoError(t, common.Unmarshal(raw, &wantCanonical))
+
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(raw))
+	c.Request.Header.Set("Content-Type", "application/json")
+	storage := newScheme3TrackingBodyStorage(raw)
+	c.Set(common.KeyBodyStorage, storage)
+	t.Cleanup(func() {
+		common.CleanupBodyStorage(c)
+	})
+
+	info := &relaycommon.RelayInfo{
+		Request:         &canonical,
+		OriginModelName: canonical.Model,
+		RelayMode:       relayconstant.RelayModeResponses,
+		RelayFormat:     types.RelayFormatOpenAIResponses,
+		RequestURLPath:  "/v1/responses",
