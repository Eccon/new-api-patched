+func configureScheme3Channel(
+	c *gin.Context,
+	channelType int,
+	baseURL string,
+	apiKey string,
+	modelMapping string,
+) {
+	common.SetContextKey(c, constant.ContextKeyChannelId, channelType)
+	common.SetContextKey(c, constant.ContextKeyChannelType, channelType)
+	common.SetContextKey(c, constant.ContextKeyChannelBaseUrl, baseURL)
+	common.SetContextKey(c, constant.ContextKeyOriginalModel, "gpt-5")
+	common.SetContextKey(c, constant.ContextKeyChannelKey, apiKey)
+	common.SetContextKey(c, constant.ContextKeyChannelSetting, dto.ChannelSettings{})
+	common.SetContextKey(c, constant.ContextKeyChannelOtherSetting, dto.ChannelOtherSettings{})
+	common.SetContextKey(c, constant.ContextKeyChannelModelMapping, modelMapping)
+}
+
+func newScheme3FailingUpstream(t *testing.T) (*httptest.Server, <-chan scheme3CapturedRequest) {
+	t.Helper()
+
+	captures := make(chan scheme3CapturedRequest, 8)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		captures <- scheme3CapturedRequest{
+			path:          r.URL.Path,
+			body:          body,
+			contentLength: r.ContentLength,
+			err:           err,
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusServiceUnavailable)
+		_, _ = io.WriteString(w, `{"error":{"message":"retry","type":"server_error","code":"upstream_error"}}`)
+	}))
+	t.Cleanup(upstream.Close)
+	return upstream, captures
+}
+
+func requireScheme3UpstreamFailure(t *testing.T, relayErr *types.NewAPIError) {
+	t.Helper()
+	require.NotNil(t, relayErr)
+	require.Equal(t, http.StatusServiceUnavailable, relayErr.StatusCode, relayErr.Error())
+}
