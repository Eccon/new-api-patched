+)
+
+func TestResponsesBodyPlanCapturedCorpus(t *testing.T) {
+	manifestPath := os.Getenv("RESPONSES_FIXTURE_MANIFEST")
+	if manifestPath == "" {
+		t.Skip("RESPONSES_FIXTURE_MANIFEST is not set")
+	}
+	previousGinMode := gin.Mode()
+	gin.SetMode(gin.TestMode)
+	t.Cleanup(func() { gin.SetMode(previousGinMode) })
+
+	rawManifest, err := os.ReadFile(manifestPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var manifest struct {
+		Records []struct {
+			ID              string `json:"id"`
+			RequestBodyPath string `json:"request_body_path"`
+		} `json:"records"`
+	}
+	if err := json.Unmarshal(rawManifest, &manifest); err != nil {
+		t.Fatal(err)
+	}
+	if len(manifest.Records) == 0 {
+		t.Fatal("capture manifest contains no request records")
+	}
+
+	root := filepath.Dir(manifestPath)
+	borrowed := 0
+	borrowEligible := 0
+	rawCodexPlans := 0
+	typedCodexPlans := 0
+	for _, record := range manifest.Records {
+		raw, err := os.ReadFile(filepath.Join(root, record.RequestBodyPath))
+		if err != nil {
+			t.Fatalf("fixture %s: %v", record.ID, err)
+		}
+		c, source, storage, before := newResponsesPlanFixture(t, string(raw), false)
+		sourceBefore := mustMarshalResponsesValue(t, source)
+		if len(raw) >= responsesRawBodyMinBytes && responsesRawShapeCompatible(raw, source) {
+			borrowEligible++
+		}
+
+		plan, err := planResponsesRequestBody(
+			c,
+			responsesPlanInfo(constant.APITypeOpenAI, relayconstant.RelayModeResponses),
+			source,
+			*source,
+		)
+		if err != nil {
+			t.Fatalf("fixture %s no-op plan: %v", record.ID, err)
+		}
+		if plan.storage != nil && responsesJSONSharesStorage(plan.canonical, plan.data) {
+			borrowed++
+		}
+		assertResponsesJSONSemanticsMatch(t, record.ID+" no-op", plan.data, sourceBefore)
+
+		converted := *source
+		converted.Model = source.Model + "-upstream"
+		if len(converted.Instructions) == 0 {
+			converted.Instructions = json.RawMessage(`""`)
+		}
+		converted.Store = json.RawMessage(`false`)
+		converted.MaxOutputTokens = nil
+		converted.Temperature = nil
+		codexPlan, err := planResponsesRequestBody(
+			c,
+			responsesPlanInfo(constant.APITypeCodex, relayconstant.RelayModeResponses),
+			source,
+			converted,
+		)
+		if err != nil {
+			t.Fatalf("fixture %s Codex plan: %v", record.ID, err)
+		}
+		if codexPlan.storage != nil {
+			rawCodexPlans++
+		} else {
+			typedCodexPlans++
+		}
+		assertResponsesJSONSemanticsMatch(t, record.ID+" Codex", codexPlan.data, mustMarshalResponsesValue(t, converted))
+		requireResponsesFixtureUnchanged(t, storage, before, source, sourceBefore)
+	}
+
+	if borrowed != borrowEligible {
+		t.Fatalf("no-op raw borrow coverage %d/%d eligible", borrowed, borrowEligible)
+	}
+	if rawCodexPlans+typedCodexPlans != len(manifest.Records) {
+		t.Fatalf("Codex planner coverage %d/%d", rawCodexPlans+typedCodexPlans, len(manifest.Records))
+	}
+	t.Logf("checked=%d no_op_borrowed=%d/%d eligible codex_raw=%d codex_typed=%d", len(manifest.Records), borrowed, borrowEligible, rawCodexPlans, typedCodexPlans)
+}
+
+func mustMarshalResponsesValue(t *testing.T, value any) []byte {
+	t.Helper()
+	data, err := common.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func assertResponsesJSONSemanticsMatch(t *testing.T, name string, gotJSON, wantJSON []byte) {
+	t.Helper()
+	var got, want any
+	if err := json.Unmarshal(gotJSON, &got); err != nil {
+		t.Fatalf("%s planned JSON: %v", name, err)
+	}
+	if err := json.Unmarshal(wantJSON, &want); err != nil {
+		t.Fatalf("%s typed JSON: %v", name, err)
+	}
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("%s changed outbound JSON semantics", name)
+	}
+}
