+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+type scheme3TrackingBodyStorage struct {
+	mu     sync.Mutex
+	data   []byte
+	reader *bytes.Reader
+	reads  int
+}
+
+func newScheme3TrackingBodyStorage(data []byte) *scheme3TrackingBodyStorage {
+	owned := bytes.Clone(data)
+	return &scheme3TrackingBodyStorage{
+		data:   owned,
+		reader: bytes.NewReader(owned),
+	}
+}
+
+func (s *scheme3TrackingBodyStorage) Read(p []byte) (int, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.reads++
+	return s.reader.Read(p)
+}
+
+func (s *scheme3TrackingBodyStorage) Seek(offset int64, whence int) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.reader.Seek(offset, whence)
+}
+
+func (s *scheme3TrackingBodyStorage) Close() error {
+	return nil
+}
+
+func (s *scheme3TrackingBodyStorage) Bytes() ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.data, nil
+}
+
+func (s *scheme3TrackingBodyStorage) Size() int64 {
+	return int64(len(s.data))
+}
+
+func (s *scheme3TrackingBodyStorage) IsDisk() bool {
+	return false
+}
+
+func (s *scheme3TrackingBodyStorage) ReadCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.reads
+}
+
+func (s *scheme3TrackingBodyStorage) Snapshot() []byte {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return bytes.Clone(s.data)
+}
+
+type scheme3CapturedRequest struct {
+	path          string
+	body          []byte
+	contentLength int64
+	err           error
+}
+
+func TestResponsesHelperScheme3RawNoopBorrowsCanonicalStorage(t *testing.T) {
+	raw := []byte(`{
+  "model": "gpt-5",
+  "input": "` + strings.Repeat("x", responsesRawBodyMinBytes) + `",
+  "reasoning": {"effort":"medium"},
+  "store": true
+}`)
+	upstream, captures := newScheme3FailingUpstream(t)
+	c, info, storage, _ := newScheme3ResponsesFixture(t, raw)
+	requireResponsesRawShapeEligible(t, string(raw), info.Request.(*dto.OpenAIResponsesRequest))
+	configureScheme3Channel(c, constant.ChannelTypeOpenAI, upstream.URL, "test-key", "")
+
+	relayErr := ResponsesHelper(c, info)
+	requireScheme3UpstreamFailure(t, relayErr)
+	capture := <-captures
+	require.NoError(t, capture.err)
+	require.Equal(t, "/v1/responses", capture.path)
+	require.Equal(t, raw, capture.body)
+	require.Equal(t, int64(len(capture.body)), capture.contentLength)
+	require.Greater(t, storage.ReadCount(), 0, "the upstream must read from the original BodyStorage")
+	require.Equal(t, raw, storage.Snapshot())
+}
+
+func TestResponsesHelperScheme3PostProcessingDoesNotBorrowStaleCanonical(t *testing.T) {
+	raw := []byte(`{
+  "model": "gpt-5",
+  "input": "` + strings.Repeat("x", responsesRawBodyMinBytes) + `"
+}`)
+	upstream, captures := newScheme3FailingUpstream(t)
+	c, info, storage, _ := newScheme3ResponsesFixture(t, raw)
+	requireResponsesRawShapeEligible(t, string(raw), info.Request.(*dto.OpenAIResponsesRequest))
+	configureScheme3Channel(c, constant.ChannelTypeOpenAI, upstream.URL, "test-key", "")
+	common.SetContextKey(c, constant.ContextKeyChannelParamOverride, map[string]any{
+		"model":             "override-model",
+		"safety_identifier": "override-user",
+	})
+
+	relayErr := ResponsesHelper(c, info)
+	requireScheme3UpstreamFailure(t, relayErr)
+	capture := <-captures
+	require.NoError(t, capture.err)
+	require.Equal(t, "override-model", gjson.GetBytes(capture.body, "model").String())
+	require.Equal(t, "override-user", gjson.GetBytes(capture.body, "safety_identifier").String())
+	require.Equal(t, int64(len(capture.body)), capture.contentLength)
+	require.Zero(t, storage.ReadCount(), "post-processing changed the body, so the original storage must not be sent")
+	require.Equal(t, raw, storage.Snapshot())
+	require.NotEqual(t, raw, capture.body)
+}
+
+func TestResponsesHelperScheme3SequentialAttemptsDoNotPolluteCanonical(t *testing.T) {
+	raw := []byte(`{
+  "model": "gpt-5",
+  "input": "` + strings.Repeat("x", responsesRawBodyMinBytes) + `",
+  "instructions": "keep the original instructions",
+  "max_output_tokens": 4096,
+  "reasoning": {"effort":"medium","summary":"auto"},
+  "store": true,
+  "temperature": 0.5
+}`)
+	upstream, captures := newScheme3FailingUpstream(t)
+	c, info, storage, wantCanonical := newScheme3ResponsesFixture(t, raw)
+	canonical := info.Request.(*dto.OpenAIResponsesRequest)
+	requireResponsesRawShapeEligible(t, string(raw), canonical)
+
+	configureScheme3Channel(c, constant.ChannelTypeOpenAI, upstream.URL, "test-key", `{"gpt-5":"gpt-5-high"}`)
+	relayErr := ResponsesHelper(c, info)
+	requireScheme3UpstreamFailure(t, relayErr)
+	first := <-captures
+	require.NoError(t, first.err)
+	require.Equal(t, "/v1/responses", first.path)
+	require.Equal(t, int64(len(first.body)), first.contentLength)
+	require.Equal(t, "gpt-5", gjson.GetBytes(first.body, "model").String())
+	require.Equal(t, "high", gjson.GetBytes(first.body, "reasoning.effort").String())
+	require.Equal(t, "auto", gjson.GetBytes(first.body, "reasoning.summary").String())
+	require.Zero(t, storage.ReadCount(), "the first attempt patches reasoning and must own its body")
+	require.Equal(t, wantCanonical, *canonical)
+	require.Equal(t, raw, storage.Snapshot())
+
+	configureScheme3Channel(
+		c,
+		constant.ChannelTypeCodex,
+		upstream.URL,
+		`{"access_token":"test-token","account_id":"test-account"}`,
+		"",
+	)
+	relayErr = ResponsesHelper(c, info)
+	requireScheme3UpstreamFailure(t, relayErr)
+	second := <-captures
+	require.NoError(t, second.err)
+	require.Equal(t, "/backend-api/codex/responses", second.path)
+	require.Equal(t, int64(len(second.body)), second.contentLength)
+	require.Equal(t, "medium", gjson.GetBytes(second.body, "reasoning.effort").String())
+	require.False(t, gjson.GetBytes(second.body, "store").Bool())
+	require.False(t, gjson.GetBytes(second.body, "max_output_tokens").Exists())
+	require.False(t, gjson.GetBytes(second.body, "temperature").Exists())
+	require.Zero(t, storage.ReadCount(), "the Codex attempt patches fields and must own its body")
+	require.Equal(t, wantCanonical, *canonical)
+	require.Equal(t, raw, storage.Snapshot())
+
+	configureScheme3Channel(c, constant.ChannelTypeOpenAI, upstream.URL, "test-key", "")
+	relayErr = ResponsesHelper(c, info)
+	requireScheme3UpstreamFailure(t, relayErr)
+	third := <-captures
+	require.NoError(t, third.err)
+	require.Equal(t, "/v1/responses", third.path)
+	require.Equal(t, int64(len(third.body)), third.contentLength)
+	require.Equal(t, raw, third.body)
+	require.Equal(t, "medium", gjson.GetBytes(third.body, "reasoning.effort").String())
+	require.True(t, gjson.GetBytes(third.body, "store").Bool())
+	require.Equal(t, uint64(4096), gjson.GetBytes(third.body, "max_output_tokens").Uint())
+	require.Greater(t, storage.ReadCount(), 0, "the final no-op attempt should borrow the canonical storage")
+	require.Equal(t, wantCanonical, *canonical)
+	require.Equal(t, raw, storage.Snapshot())
+}
+
+func TestResponsesHelperScheme3ConcurrentAttemptConversionIsRaceFriendly(t *testing.T) {
+	raw := []byte(`{
+  "model": "base-model",
+  "input": [{"role":"user","content":"shared read-only input"}],
+  "reasoning": {"effort":"medium","summary":"auto"},
+  "tools": [{"type":"function","name":"lookup"}]
+}`)
+	var canonical dto.OpenAIResponsesRequest
+	require.NoError(t, common.Unmarshal(raw, &canonical))
+	var wantCanonical dto.OpenAIResponsesRequest
+	require.NoError(t, common.Unmarshal(raw, &wantCanonical))
+
+	type conversionCase struct {
+		apiType     int
+		channelType int
+		model       string
+		wantModel   string
+		wantEffort  string
+	}
+	cases := []conversionCase{
+		{
+			apiType:     constant.APITypeOpenAI,
+			channelType: constant.ChannelTypeOpenAI,
+			model:       "gpt-5-high",
+			wantModel:   "gpt-5",
+			wantEffort:  "high",
+		},
+		{
+			apiType:     constant.APITypeDeepSeek,
+			channelType: constant.ChannelTypeDeepSeek,
+			model:       "deepseek-v4-chat-max",
+			wantModel:   "deepseek-v4-chat",
+			wantEffort:  "max",
+		},
+	}
+
+	type conversionResult struct {
+		body []byte
+		err  error
+	}
+	start := make(chan struct{})
+	results := make(chan conversionResult, len(cases))
+	var wg sync.WaitGroup
+	for _, testCase := range cases {
+		testCase := testCase
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+
+			attempt, err := cloneOpenAIResponsesAttempt(&canonical)
+			if err != nil {
+				results <- conversionResult{err: err}
+				return
+			}
+			attempt.Model = testCase.model
+			info := &relaycommon.RelayInfo{
+				OriginModelName: testCase.model,
+				RelayMode:       relayconstant.RelayModeResponses,
+				RelayFormat:     types.RelayFormatOpenAIResponses,
+				ChannelMeta: &relaycommon.ChannelMeta{
+					ApiType:           testCase.apiType,
+					ChannelType:       testCase.channelType,
+					UpstreamModelName: testCase.model,
+				},
+			}
+			adaptor := GetAdaptor(testCase.apiType)
+			adaptor.Init(info)
+			converted, err := adaptor.ConvertOpenAIResponsesRequest(nil, info, *attempt)
+			if err != nil {
+				results <- conversionResult{err: err}
+				return
+			}
+			body, err := common.Marshal(converted)
+			results <- conversionResult{body: body, err: err}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+
+	seen := make(map[string]string, len(cases))
+	for result := range results {
+		require.NoError(t, result.err)
+		seen[gjson.GetBytes(result.body, "model").String()] = gjson.GetBytes(result.body, "reasoning.effort").String()
+	}
+	for _, testCase := range cases {
+		assert.Equal(t, testCase.wantEffort, seen[testCase.wantModel])
+	}
+	require.Equal(t, wantCanonical, canonical)
+}
+
