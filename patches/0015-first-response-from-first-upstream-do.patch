+func (info *RelayInfo) MarkFirstUpstreamDoStart(t time.Time) {
+	if info.responseStartTime.IsZero() {
+		info.responseStartTime = t
+	}
+}
+
+func (info *RelayInfo) PreserveLegacyFirstResponseStartTime() {
+	info.MarkFirstUpstreamDoStart(info.StartTime)
+}
+
+func (info *RelayInfo) FirstResponseStartTime() time.Time {
+	if !info.responseStartTime.IsZero() {
+		return info.responseStartTime
+	}
+	return info.StartTime
+}
+
 func (info *RelayInfo) HasSendResponse() bool {
 	return info.FirstResponseTime.After(info.StartTime)
 }
