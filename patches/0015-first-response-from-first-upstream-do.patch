+func TestDoRequestRecordsFirstUpstreamStartWithoutTimingLogs(t *testing.T) {
+	previousTimingLogEnabled := common.RelayTimingLogEnabled
+	common.RelayTimingLogEnabled = false
+	t.Cleanup(func() {
+		common.RelayTimingLogEnabled = previousTimingLogEnabled
+	})
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(server.Close)
+
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", http.NoBody)
+	requestStart := time.Date(2020, time.January, 1, 0, 0, 0, 0, time.UTC)
+	info := &relaycommon.RelayInfo{
+		StartTime:       requestStart,
+		OriginModelName: "test-model",
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ChannelId: 17,
+		},
+	}
+
+	cancelledContext, cancel := context.WithCancel(context.Background())
+	cancel()
+	request, err := http.NewRequestWithContext(cancelledContext, http.MethodPost, server.URL, strings.NewReader(`{"model":"test-model"}`))
+	require.NoError(t, err)
+	response, err := doRequest(ctx, request, info)
+	require.Error(t, err)
+	require.Nil(t, response)
+	firstDo := info.FirstResponseStartTime()
+	require.True(t, firstDo.After(requestStart))
+	require.True(t, info.Timing.DoStart.IsZero())
+
+	ctx.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", http.NoBody)
+	retryRequest, err := http.NewRequest(http.MethodPost, server.URL, strings.NewReader(`{"model":"test-model"}`))
+	require.NoError(t, err)
+	retryResponse, err := doRequest(ctx, retryRequest, info)
+	require.NoError(t, err)
+	require.NoError(t, retryResponse.Body.Close())
+	require.Equal(t, firstDo, info.FirstResponseStartTime())
+}
