+package perfmetrics
+
+import (
+	"testing"
+	"time"
+
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRecordRelaySampleUsesFirstUpstreamDoForTTFT(t *testing.T) {
+	requestStart := time.Now().Add(-3 * time.Second)
+	firstDo := requestStart.Add(time.Second)
+	firstResponse := firstDo.Add(1500 * time.Millisecond)
+	info := &relaycommon.RelayInfo{
+		StartTime:         requestStart,
+		FirstResponseTime: firstResponse,
+		IsStream:          true,
+		OriginModelName:   "test-first-upstream-do-ttft",
+		UsingGroup:        "test",
+	}
+	info.MarkFirstUpstreamDoStart(firstDo)
+
+	RecordRelaySample(info, true, 0)
+
+	var recorded counters
+	found := false
+	hotBuckets.Range(func(rawKey, rawValue any) bool {
+		key := rawKey.(bucketKey)
+		if key.model != info.OriginModelName || key.group != info.UsingGroup {
+			return true
+		}
+		recorded = rawValue.(*atomicBucket).snapshot()
+		hotBuckets.Delete(rawKey)
+		found = true
+		return false
+	})
+	require.True(t, found)
+	require.Equal(t, int64(1500), recorded.ttftSumMs)
+	require.Equal(t, int64(1), recorded.ttftCount)
+}
