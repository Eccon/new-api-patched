+func normalizeRelayDirectNetworkFamily(value string) (string, bool) {
+	normalized := strings.ToLower(strings.TrimSpace(value))
+	switch normalized {
+	case "", RelayDirectNetworkFamilyAuto:
+		return RelayDirectNetworkFamilyAuto, true
+	case RelayDirectNetworkFamilyIPv4Only:
+		return RelayDirectNetworkFamilyIPv4Only, true
+	case RelayDirectNetworkFamilyIPv6Only:
+		return RelayDirectNetworkFamilyIPv6Only, true
+	default:
+		return RelayDirectNetworkFamilyAuto, false
+	}
+}
