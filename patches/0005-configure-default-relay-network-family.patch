+func applyRelayDirectNetworkFamily(transport *http.Transport) {
+	if transport == nil || transport.DialContext == nil {
+		return
+	}
+
+	var network string
+	switch common.RelayDirectNetworkFamily {
+	case common.RelayDirectNetworkFamilyIPv4Only:
+		network = "tcp4"
+	case common.RelayDirectNetworkFamilyIPv6Only:
+		network = "tcp6"
+	default:
+		return
+	}
+
+	baseDialContext := transport.DialContext
+	transport.DialContext = func(ctx context.Context, _ string, addr string) (net.Conn, error) {
+		return baseDialContext(ctx, network, addr)
+	}
+}
