+func TestDirectNetworkFamilyAppliesToEveryShard(t *testing.T) {
+	withRelayHTTPTransportSettings(t)
+	previousFamily := common.RelayDirectNetworkFamily
+	common.RelayDirectNetworkFamily = common.RelayDirectNetworkFamilyIPv4Only
+	t.Cleanup(func() {
+		common.RelayDirectNetworkFamily = previousFamily
+	})
+
+	client, err := newHTTPClientFromPolicy(HTTPTransportPolicy{
+		Protocol: dto.HTTPProtocolAuto,
+		Shards:   3,
+	}, nil, nil)
+	require.NoError(t, err)
+	sharded, ok := client.Transport.(*shardedRoundTripper)
+	require.True(t, ok)
+	require.Len(t, sharded.shards, 3)
+
+	for _, shard := range sharded.shards {
+		transport, ok := shard.(*http.Transport)
+		require.True(t, ok)
+		_, err := transport.DialContext(context.Background(), "tcp", "[::1]:443")
+		require.Error(t, err)
+		var opErr *net.OpError
+		require.ErrorAs(t, err, &opErr)
+		assert.Equal(t, "tcp4", opErr.Net)
+	}
+}
