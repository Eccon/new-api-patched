@@ -0,0 +1,28 @@
+package common
+
+import "testing"
+
+func TestNormalizeRelayDirectNetworkFamily(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  string
+		valid bool
+	}{
+		{name: "empty", input: "", want: RelayDirectNetworkFamilyAuto, valid: true},
+		{name: "auto", input: "auto", want: RelayDirectNetworkFamilyAuto, valid: true},
+		{name: "ipv4 only", input: "ipv4_only", want: RelayDirectNetworkFamilyIPv4Only, valid: true},
+		{name: "ipv6 only", input: "ipv6_only", want: RelayDirectNetworkFamilyIPv6Only, valid: true},
+		{name: "normalizes case and space", input: " IPv4_ONLY ", want: RelayDirectNetworkFamilyIPv4Only, valid: true},
+		{name: "invalid", input: "ipv4_first", want: RelayDirectNetworkFamilyAuto, valid: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, valid := normalizeRelayDirectNetworkFamily(tt.input)
+			if got != tt.want || valid != tt.valid {
+				t.Fatalf("normalizeRelayDirectNetworkFamily(%q) = (%q, %t), want (%q, %t)", tt.input, got, valid, tt.want, tt.valid)
+			}
+		})
+	}
+}
