+func TestApplyRelayDirectNetworkFamilyUsesInheritedDialContext(t *testing.T) {
+	previousFamily := common.RelayDirectNetworkFamily
+	t.Cleanup(func() {
+		common.RelayDirectNetworkFamily = previousFamily
+	})
+
+	tests := []struct {
+		name        string
+		family      string
+		wantNetwork string
+	}{
+		{name: "auto", family: common.RelayDirectNetworkFamilyAuto, wantNetwork: "tcp"},
+		{name: "ipv4 only", family: common.RelayDirectNetworkFamilyIPv4Only, wantNetwork: "tcp4"},
+		{name: "ipv6 only", family: common.RelayDirectNetworkFamilyIPv6Only, wantNetwork: "tcp6"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			wantErr := errors.New("inherited dialer error")
+			ctx := context.WithValue(context.Background(), struct{}{}, "value")
+			var gotContext context.Context
+			var gotNetwork, gotAddress string
+			transport := &http.Transport{
+				DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+					gotContext = ctx
+					gotNetwork = network
+					gotAddress = address
+					return nil, wantErr
+				},
+			}
+
+			common.RelayDirectNetworkFamily = tt.family
+			applyRelayDirectNetworkFamily(transport)
+			_, err := transport.DialContext(ctx, "tcp", "relay.example:443")
+
+			require.ErrorIs(t, err, wantErr)
+			assert.Same(t, ctx, gotContext)
+			assert.Equal(t, tt.wantNetwork, gotNetwork)
+			assert.Equal(t, "relay.example:443", gotAddress)
+		})
+	}
+}
+
+func TestApplyRelayDirectNetworkFamilyPreservesCancellation(t *testing.T) {
+	previousFamily := common.RelayDirectNetworkFamily
+	common.RelayDirectNetworkFamily = common.RelayDirectNetworkFamilyIPv4Only
+	t.Cleanup(func() {
+		common.RelayDirectNetworkFamily = previousFamily
+	})
+
+	type dialCall struct {
+		context context.Context
+		network string
+		address string
+	}
+	seenCall := make(chan dialCall, 1)
+	transport := &http.Transport{
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			seenCall <- dialCall{context: ctx, network: network, address: address}
+			<-ctx.Done()
+			return nil, ctx.Err()
+		},
+	}
+	applyRelayDirectNetworkFamily(transport)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	errCh := make(chan error, 1)
+	go func() {
+		_, err := transport.DialContext(ctx, "tcp", "relay.example:443")
+		errCh <- err
+	}()
+
+	call := <-seenCall
+	assert.Same(t, ctx, call.context)
+	assert.Equal(t, "tcp4", call.network)
+	assert.Equal(t, "relay.example:443", call.address)
+	cancel()
+	require.ErrorIs(t, <-errCh, context.Canceled)
+}
