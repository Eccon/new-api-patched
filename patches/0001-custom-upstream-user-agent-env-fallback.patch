+}
+
+func sendUserAgentTestRequest(kind string, a *userAgentSigningAdaptor, c *gin.Context, info *relaycommon.RelayInfo) error {
+	if kind == "websocket" {
+		conn, err := DoWssRequest(a, c, info, nil)
+		if conn != nil {
+			_ = conn.Close()
+		}
+		return err
+	}
+	var resp *http.Response
+	var err error
+	body := strings.NewReader(`{}`)
+	switch kind {
+	case "api":
+		resp, err = DoApiRequest(a, c, info, body)
+	case "form":
+		resp, err = DoFormRequest(a, c, info, body)
+	case "task":
+		resp, err = DoTaskApiRequest(&userAgentTaskAdaptor{base: a}, c, info, body)
+	}
+	if resp != nil {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			return errors.New("upstream rejected the signed UA")
+		}
+	}
+	return err
+}
+
+// Each sender must sign the selected UA exactly once and send it unchanged,
+// even when the signer deliberately replaces it with the client's UA.
+func TestUpstreamUserAgentSigningOrder(t *testing.T) {
+	original := common.UpstreamUserAgentOpenAI
+	t.Cleanup(func() { common.UpstreamUserAgentOpenAI = original })
+	signErr := errors.New("test signing failure")
+	for _, kind := range []string{"api", "form", "task", "websocket"} {
+		t.Run(kind, func(t *testing.T) {
+			for _, tc := range []struct {
+				name       string
+				env        string
+				adaptorUA  string
+				override   map[string]any
+				wantBefore string
+				rewrite    bool
+				fail       bool
+			}{
+				{name: "environment", env: "env-ua", wantBefore: "env-ua"},
+				{name: "client fallback", wantBefore: "client-ua"},
+				{name: "adaptor UA", env: "env-ua", adaptorUA: "adaptor-ua", wantBefore: "adaptor-ua"},
+				{name: "channel override", env: "env-ua", override: map[string]any{"User-Agent": "channel-ua"}, wantBefore: "channel-ua"},
+				{name: "empty channel override is ignored", env: "env-ua", override: map[string]any{"User-Agent": ""}, wantBefore: "env-ua"},
+				{name: "signer rewrites UA", env: "env-ua", wantBefore: "env-ua", rewrite: true},
+				{name: "signing fails", env: "env-ua", wantBefore: "env-ua", fail: true},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					common.UpstreamUserAgentOpenAI = tc.env
+					var requests atomic.Int32
+					seen := make(chan string, 1)
+					upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						requests.Add(1)
+						seen <- r.UserAgent()
+						if r.Header.Get("X-Signed-UA") != r.UserAgent() {
+							w.WriteHeader(http.StatusUnauthorized)
+							return
+						}
+						if kind == "websocket" {
+							upgrader := websocket.Upgrader{}
+							conn, err := upgrader.Upgrade(w, r, nil)
+							if err == nil {
+								_ = conn.Close()
+							}
+							return
+						}
+						_, _ = w.Write([]byte(`{}`))
+					}))
+					t.Cleanup(upstream.Close)
+					c, _ := gin.CreateTestContext(httptest.NewRecorder())
+					c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{}`))
+					c.Request.Header.Set("User-Agent", "client-ua")
+					info := &relaycommon.RelayInfo{
+						RelayFormat: types.RelayFormatOpenAI,
+						ChannelMeta: &relaycommon.ChannelMeta{HeadersOverride: tc.override},
+					}
+					var before string
+					calls := 0
+					a := &userAgentSigningAdaptor{
+						userAgentTestAdaptor: &userAgentTestAdaptor{target: upstream.URL, ua: tc.adaptorUA},
+						sign: func(header http.Header) error {
+							calls++
+							before = header.Get("User-Agent")
+							if tc.fail {
+								return signErr
+							}
+							if tc.rewrite {
+								header.Set("User-Agent", "client-ua")
+							}
+							header.Set("X-Signed-UA", header.Get("User-Agent"))
+							return nil
+						},
+					}
+
+					err := sendUserAgentTestRequest(kind, a, c, info)
+					require.Equal(t, 1, calls)
+					require.Equal(t, tc.wantBefore, before)
+					if tc.fail {
+						require.ErrorIs(t, err, signErr)
+						require.Zero(t, requests.Load())
+						return
+					}
+					require.NoError(t, err)
+					want := tc.wantBefore
+					if tc.rewrite {
+						want = "client-ua"
+					}
+					require.Equal(t, int32(1), requests.Load())
+					require.Equal(t, want, <-seen)
+				})
+			}
+		})
+	}
+}
