+package providerplugin
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/pkg/jsplugin"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+// Exercise the real JS signer and both steps of a converted provider request.
+func TestProviderChainSignsFinalUserAgent(t *testing.T) {
+	original := common.UpstreamUserAgentOpenAI
+	common.UpstreamUserAgentOpenAI = "env-ua"
+	t.Cleanup(func() { common.UpstreamUserAgentOpenAI = original })
+	plugin, err := jsplugin.NewRegistry().Register(`
+export const meta = {
+  apiVersion: 1, key: "ua-signing-chain", name: "UA signing", version: "1.0.0", author: {name: "Test"},
+  relay: [{incoming_path: "/v1/chat/completions", upstream_path: "/first", converter: "plugin"}],
+};
+let signatures = 0;
+export function convertRequest(ctx, req) { return {body: req.body}; }
+export function convertStreamEvent() { return {events: []}; }
+export function signRequest(ctx, req) {
+  signatures++;
+  return {headers: {
+    "X-Signed-UA": req.headers["User-Agent"] || "",
+    "X-Sign-Count": String(signatures),
+    "X-Body-Hash": req.bodySha256,
+  }};
+}
+export function convertResponse(ctx, res) {
+  if (JSON.parse(res.body).next) return {next: {path: "/next"}};
+  return {body: {done: true}};
+}
+`, jsplugin.Options{})
+	require.NoError(t, err)
+	seen := make(chan string, 2)
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		seen <- r.Method + " " + r.URL.Path + " " + r.UserAgent() + " " + r.Header.Get("X-Sign-Count")
+		if r.UserAgent() != "env-ua" || r.Header.Get("X-Signed-UA") != r.UserAgent() || r.Header.Get("X-Body-Hash") != fmt.Sprintf("%x", sha256.Sum256(body)) {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = w.Write([]byte(`{}`))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/first" {
+			_, _ = w.Write([]byte(`{"next":true}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"done":true}`))
+	}))
+	t.Cleanup(upstream.Close)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{"model":"test"}`))
+	c.Request.Header.Set("User-Agent", "client-ua")
+	info := &relaycommon.RelayInfo{
+		RelayFormat: types.RelayFormatOpenAI, RequestURLPath: "/v1/chat/completions",
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ChannelType: constant.ChannelTypeTaskPlugin, ChannelBaseUrl: upstream.URL, ApiKey: "test-key",
+			ChannelOtherSettings: dto.ChannelOtherSettings{AdvancedCustom: plugin.Meta.ChannelRelayConfig(nil)},
+		},
+	}
+	a := &Adaptor{plugin: plugin}
+	a.Init(info)
+	response, err := a.runChain(c, info, jsplugin.ConvertedRequest{Body: []byte(`{"model":"test"}`)}, []byte(`{"model":"test"}`), "application/json", nil)
+	require.NoError(t, err)
+	resp := response.(*http.Response)
+	defer resp.Body.Close()
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"done":true}`, string(body))
+	require.Len(t, seen, 2)
+	require.Equal(t, "POST /first env-ua 1", <-seen)
+	require.Equal(t, "GET /next env-ua 2", <-seen)
+}
diff --git a/relay/channel/upstream_user_agent.go b/relay/channel/upstream_user_agent.go
new file mode 100644
index 0000000..4172b5d
--- /dev/null
+++ b/relay/channel/upstream_user_agent.go
@@ -0,0 +1,118 @@
+package channel
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/logger"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/types"
+
+	"github.com/gin-gonic/gin"
+)
+
+const netHTTPDefaultUserAgent = "Go-http-client/2.0"
+const upstreamUserAgentOverriddenContextKey = "upstream_user_agent_overridden"
+
+func configuredUpstreamUserAgent(info *relaycommon.RelayInfo) string {
+	if info == nil {
+		return ""
+	}
+
+	switch info.GetFinalRequestRelayFormat() {
+	case types.RelayFormatClaude:
+		return strings.TrimSpace(common.UpstreamUserAgentClaude)
+	case types.RelayFormatGemini:
+		return strings.TrimSpace(common.UpstreamUserAgentGemini)
+	case types.RelayFormatOpenAI,
+		types.RelayFormatOpenAIResponses,
+		types.RelayFormatOpenAIResponsesCompaction,
+		types.RelayFormatOpenAIAlphaSearch,
+		types.RelayFormatOpenAIAudio,
+		types.RelayFormatOpenAIImage,
+		types.RelayFormatOpenAIRealtime:
+		return strings.TrimSpace(common.UpstreamUserAgentOpenAI)
+	}
+	return ""
+}
+
+func incomingRequestUserAgent(c *gin.Context) string {
+	if c == nil || c.Request == nil {
+		return ""
+	}
+	return strings.TrimSpace(c.Request.UserAgent())
+}
+
+func syncUpstreamUserAgentOverrideState(c *gin.Context, headers map[string]string) {
+	if c == nil {
+		return
+	}
+	overridden := false
+	for key := range headers {
+		if strings.EqualFold(key, "User-Agent") {
+			overridden = true
+			break
+		}
+	}
+	c.Set(upstreamUserAgentOverriddenContextKey, overridden)
+}
+
+func upstreamUserAgentOverridden(c *gin.Context) bool {
+	if c == nil {
+		return false
+	}
+	value, exists := c.Get(upstreamUserAgentOverriddenContextKey)
+	if !exists {
+		return false
+	}
+	overridden, ok := value.(bool)
+	return ok && overridden
+}
+
+func applyDefaultUpstreamUserAgent(c *gin.Context, req *http.Request, info *relaycommon.RelayInfo) {
+	if req == nil {
+		return
+	}
+	if upstreamUserAgentOverridden(c) {
+		return
+	}
+	requestUA := incomingRequestUserAgent(c)
+	upstreamUA := strings.TrimSpace(req.Header.Get("User-Agent"))
+	if userAgent := configuredUpstreamUserAgent(info); userAgent != "" {
+		if upstreamUA == "" || upstreamUA == requestUA {
+			req.Header.Set("User-Agent", userAgent)
+		}
+		return
+	}
+	if upstreamUA != "" {
+		return
+	}
+	if requestUA != "" {
+		req.Header.Set("User-Agent", requestUA)
+	}
+}
+
+func effectiveUpstreamUserAgent(req *http.Request) string {
+	if req == nil {
+		return ""
+	}
+	if _, ok := req.Header["User-Agent"]; ok {
+		return strings.TrimSpace(req.Header.Get("User-Agent"))
+	}
+	return netHTTPDefaultUserAgent
+}
+
+func logUpstreamUserAgent(c *gin.Context, req *http.Request) {
+	if req == nil {
+		return
+	}
+	requestUA := incomingRequestUserAgent(c)
+	upstreamUA := effectiveUpstreamUserAgent(req)
+	if requestUA != upstreamUA {
+		logger.LogInfo(c, fmt.Sprintf("user-agent rewrite: request=%q -> upstream=%q", requestUA, upstreamUA))
+		return
+	}
+	logger.LogInfo(c, fmt.Sprintf("user-agent passthrough: upstream=%q (same as request)", upstreamUA))
+}
