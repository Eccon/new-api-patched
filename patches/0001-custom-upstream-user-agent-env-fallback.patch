+func TestUpstreamUserAgentWithoutSigner(t *testing.T) {
+	original := common.UpstreamUserAgentOpenAI
+	common.UpstreamUserAgentOpenAI = "env-ua"
+	t.Cleanup(func() { common.UpstreamUserAgentOpenAI = original })
+	for _, direct := range []bool{false, true} {
+		t.Run(map[bool]string{false: "api", true: "direct"}[direct], func(t *testing.T) {
+			seen := make(chan string, 1)
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				seen <- r.UserAgent()
+				_, _ = w.Write([]byte(`{}`))
+			}))
+			t.Cleanup(upstream.Close)
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{}`))
+			c.Request.Header.Set("User-Agent", "client-ua")
+			info := &relaycommon.RelayInfo{RelayFormat: types.RelayFormatOpenAI, ChannelMeta: &relaycommon.ChannelMeta{}}
+			var resp *http.Response
+			var err error
+			if direct {
+				var req *http.Request
+				req, err = http.NewRequest(http.MethodPost, upstream.URL, nil)
+				require.NoError(t, err)
+				resp, err = DoRequest(c, req, info)
+			} else {
+				resp, err = DoApiRequest(&userAgentTestAdaptor{target: upstream.URL}, c, info, nil)
+			}
+			require.NoError(t, err)
+			_ = resp.Body.Close()
+			require.Equal(t, "env-ua", <-seen)
+		})
+	}
+}
