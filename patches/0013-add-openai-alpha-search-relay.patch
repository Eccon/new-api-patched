+
+func TestBuildAlphaSearchBodyOnlyReplacesModel(t *testing.T) {
+	body := []byte(`{
+		"id":"search-session",
+		"model":"gpt-client",
+		"commands":{"search_query":[{"q":"OpenAI news","recency":7}]},
+		"settings":{"search_context_size":"low"},
+		"future_field":{"preserved":true}
+	}`)
+
+	got, err := buildAlphaSearchBody(body, "gpt-upstream")
+	require.NoError(t, err)
+
+	var payload map[string]interface{}
+	require.NoError(t, common.Unmarshal(got, &payload))
