+package model
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func insertAlphaSearchChannelCandidate(t *testing.T, id int, channelType int, priority int64) {
+	t.Helper()
+	require.NoError(t, DB.Create(&Channel{
+		Id:     id,
+		Type:   channelType,
+		Key:    fmt.Sprintf("key-%d", id),
+		Status: common.ChannelStatusEnabled,
+		Name:   fmt.Sprintf("channel-%d", id),
+	}).Error)
+	require.NoError(t, DB.Create(&Ability{
+		Group:     "default",
+		Model:     "gpt-5.6",
+		ChannelId: id,
+		Enabled:   true,
+		Priority:  &priority,
+	}).Error)
+}
+
+func TestGetAlphaSearchChannelFiltersTypeBeforePriority(t *testing.T) {
+	truncateTables(t)
+	insertAlphaSearchChannelCandidate(t, 9101, constant.ChannelTypeCodex, 100)
+	insertAlphaSearchChannelCandidate(t, 9102, constant.ChannelTypeOpenRouter, 90)
+	insertAlphaSearchChannelCandidate(t, 9103, constant.ChannelTypeOpenAI, 10)
+
+	channel, err := GetChannel("default", "gpt-5.6", 0, constant.AlphaSearchPath)
+	require.NoError(t, err)
+	require.NotNil(t, channel)
+	assert.Equal(t, 9103, channel.Id)
+	assert.Equal(t, constant.ChannelTypeOpenAI, channel.Type)
+}
+
+func TestChannelSupportsRequestPathRestrictsAlphaSearch(t *testing.T) {
+	assert.True(t, ChannelSupportsRequestPath(&Channel{Type: constant.ChannelTypeOpenAI}, constant.AlphaSearchPath, "gpt-5.6"))
+	assert.False(t, ChannelSupportsRequestPath(&Channel{Type: constant.ChannelTypeCodex}, constant.AlphaSearchPath, "gpt-5.6"))
+	assert.False(t, ChannelSupportsRequestPath(&Channel{Type: constant.ChannelTypeOpenRouter}, constant.AlphaSearchPath, "gpt-5.6"))
+	assert.True(t, ChannelSupportsRequestPath(&Channel{Type: constant.ChannelTypeOpenAI}, "/v1/responses", "gpt-5.6"))
+}
