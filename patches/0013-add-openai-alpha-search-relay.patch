+		common.SysError("settle alpha search billing error: " + err.Error())
+	}
+
+	if info.Billing == nil || !info.Billing.NeedsRefund() {
+		return
+	}
+	chargedQuota := info.Billing.GetPreConsumedQuota()
+	info.PriceData.Quota = chargedQuota
+	common.SetContextKey(c, constant.ContextKeyAlphaSearchBillingFallback, true)
+	if err := service.SettleBilling(c, info, chargedQuota); err != nil {
+		common.SysError("finalize alpha search reserved billing error: " + err.Error())
+	}
+}
