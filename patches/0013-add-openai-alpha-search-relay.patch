+// AlphaSearchPriceHelper prices one standalone search request using the
+// model-aware web_search tool price, which is configured in dollars per 1K calls.
+func AlphaSearchPriceHelper(c *gin.Context, info *relaycommon.RelayInfo) (types.PriceData, error) {
+	groupRatioInfo := HandleGroupRatio(c, info)
+	pricePer1K := operation_setting.GetToolPriceForModel("web_search", info.OriginModelName)
+	if pricePer1K < 0 || math.IsNaN(pricePer1K) || math.IsInf(pricePer1K, 0) {
+		return types.PriceData{}, errors.New("web_search price is invalid")
+	}
+	if groupRatioInfo.GroupRatio < 0 || math.IsNaN(groupRatioInfo.GroupRatio) || math.IsInf(groupRatioInfo.GroupRatio, 0) {
+		return types.PriceData{}, errors.New("group ratio is invalid")
+	}
+	pricePerCall := pricePer1K / 1000
+
+	quota, clamp := common.QuotaRoundChecked(pricePerCall * common.QuotaPerUnit * groupRatioInfo.GroupRatio)
+	if clamp != nil {
+		info.QuotaClamp = clamp
+		return types.PriceData{}, clamp
+	}
+
+	freeModel := false
+	if !operation_setting.GetQuotaSetting().EnableFreeModelPreConsume &&
+		(pricePerCall == 0 || groupRatioInfo.GroupRatio == 0) {
+		freeModel = true
+	}
+
+	priceData := types.PriceData{
+		FreeModel:         freeModel,
+		ModelPrice:        pricePerCall,
+		UsePrice:          true,
+		Quota:             quota,
+		QuotaToPreConsume: quota,
+		GroupRatioInfo:    groupRatioInfo,
+	}
+	info.PriceData = priceData
+	return priceData, nil
+}
