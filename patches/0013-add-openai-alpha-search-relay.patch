+func alphaSearchRequestURL(info *relaycommon.RelayInfo) (string, error) {
+	if info == nil {
+		return "", errors.New("relay info is nil")
+	}
+	baseURL, err := url.Parse(info.ChannelBaseUrl)
+	if err != nil {
+		return "", fmt.Errorf("parse channel base URL: %w", err)
+	}
+	if baseURL.Scheme == "" || baseURL.Host == "" {
+		return "", fmt.Errorf("invalid channel base URL")
+	}
+	requestURL, err := url.Parse(info.RequestURLPath)
+	if err != nil {
+		return "", fmt.Errorf("parse alpha search request URL: %w", err)
+	}
+
+	requestPath := constant.AlphaSearchPath
+	// Keep the same Cloudflare AI Gateway convention as GetFullRequestURL:
+	// its OpenAI base URL already includes the provider API prefix.
+	if strings.HasPrefix(info.ChannelBaseUrl, "https://gateway.ai.cloudflare.com") {
+		requestPath = strings.TrimPrefix(requestPath, "/v1")
+	}
+	baseURL.Path = strings.TrimRight(baseURL.Path, "/") + requestPath
+	baseURL.RawPath = ""
+	query := baseURL.Query()
+	for key, values := range requestURL.Query() {
+		for _, value := range values {
+			query.Add(key, value)
+		}
+	}
+	baseURL.RawQuery = query.Encode()
+	baseURL.Fragment = ""
+	return baseURL.String(), nil
+}
