+package service
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/types"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLogAlphaSearchConsumptionRecordsRetryChain(t *testing.T) {
+	truncate(t)
+
+	const (
+		userID         = 41
+		finalChannelID = 74
+		requestID      = "alpha-search-retry-log"
+	)
+	seedUser(t, userID, 10_000)
+	seedChannel(t, finalChannelID)
+
+	gin.SetMode(gin.TestMode)
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx.Request = httptest.NewRequest(http.MethodPost, constant.AlphaSearchPath, nil)
+	ctx.Set("username", "test_user")
+	ctx.Set("token_name", "test_token")
+	ctx.Set(common.RequestIdKey, requestID)
+	ctx.Set("use_channel", []string{"78", "85", "74"})
+
+	info := &relaycommon.RelayInfo{
+		UserId:          userID,
+		OriginModelName: "gpt-5.6-sol",
+		UsingGroup:      "code",
+		StartTime:       time.Now().Add(-time.Second),
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ChannelId: finalChannelID,
+		},
+		PriceData: types.PriceData{
+			ModelPrice: 0.004,
+			Quota:      2_000,
+			GroupRatioInfo: types.GroupRatioInfo{
+				GroupRatio: 0.4,
+			},
+		},
+		QuotaClamp: &common.QuotaClamp{
+			Op:       "QuotaFromFloat",
+			Kind:     common.QuotaClampOverflow,
+			Original: 1e30,
+			Clamped:  common.MaxQuota,
+		},
+	}
+
+	LogAlphaSearchConsumption(ctx, info)
+
+	var log model.Log
+	require.NoError(t, model.LOG_DB.Where("request_id = ?", requestID).First(&log).Error)
+	assert.Equal(t, finalChannelID, log.ChannelId)
+
+	other, err := common.StrToMap(log.Other)
+	require.NoError(t, err)
+	adminInfo, ok := other["admin_info"].(map[string]interface{})
+	require.True(t, ok)
+	assert.Equal(t, []interface{}{"78", "85", "74"}, adminInfo["use_channel"])
+
+	quotaSaturation, ok := adminInfo["quota_saturation"].(map[string]interface{})
+	require.True(t, ok)
+	assert.Equal(t, "QuotaFromFloat", quotaSaturation["op"])
+}
