+
+// GetHttpClientWithProxyForRelay returns a policy-aware relay client with the
+// request-mode timeout while retaining the cached transport and connection pool.
+func GetHttpClientWithProxyForRelay(rawProxyURL string, settings dto.ChannelSettings, stream bool) (*http.Client, error) {
+	client, err := getHttpClientWithProxyPolicy(rawProxyURL, NormalizeRelayHTTPTransportPolicy(settings, stream))
+	if err != nil {
+		return nil, err
+	}
+	return relayHTTPClientWithTimeout(client, stream), nil
+}
+
+func relayHTTPClientTimeout(stream bool) time.Duration {
+	timeoutSeconds := common.RelayTimeout
+	if !stream && common.RelayNonStreamTimeout > 0 {
+		timeoutSeconds = common.RelayNonStreamTimeout
+		if common.RelayTimeout > 0 && timeoutSeconds > common.RelayTimeout {
+			timeoutSeconds = common.RelayTimeout
+		}
+	}
+	if timeoutSeconds <= 0 {
+		return 0
+	}
+	return time.Duration(timeoutSeconds) * time.Second
+}
+
+func relayHTTPClientWithTimeout(client *http.Client, stream bool) *http.Client {
+	timeout := relayHTTPClientTimeout(stream)
+	if client.Timeout == timeout {
+		return client
+	}
+	relayClient := *client
+	relayClient.Timeout = timeout
+	return &relayClient
+}
+
