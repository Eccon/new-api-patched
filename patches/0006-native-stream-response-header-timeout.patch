+// the normalized channel transport policy used for caching and diagnostics.
+func NormalizeRelayHTTPTransportPolicy(settings dto.ChannelSettings, stream bool) HTTPTransportPolicy {
 	policy := NormalizeHTTPTransportPolicy(settings)
+	if stream && common.RelayResponseHeaderTimeout > 0 {
+		policy.ResponseHeaderTimeout = time.Duration(common.RelayResponseHeaderTimeout) * time.Second
+	}
+	return policy
+}
