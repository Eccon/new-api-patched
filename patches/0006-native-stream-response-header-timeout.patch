+func TestRelayResponseHeaderTimeoutIsPartOfProxyCacheKey(t *testing.T) {
+	initDefaultHTTPClientFixture(t)
+	settings := dto.ChannelSettings{HTTPProtocol: dto.HTTPProtocolHTTP1}
+	proxyURL := "http://relay-timeout-proxy.example:8080"
+
+	regular, err := GetHttpClientWithProxySettings(proxyURL, settings)
+	require.NoError(t, err)
+
+	common.RelayResponseHeaderTimeout = 3
+	threeSeconds, err := GetHttpClientWithProxyForRelay(proxyURL, settings, true)
+	require.NoError(t, err)
+	threeSecondsAlias, err := GetHttpClientWithProxyForRelay(proxyURL+"/", settings, true)
+	require.NoError(t, err)
+	assert.NotSame(t, regular, threeSeconds)
+	assert.Same(t, threeSeconds, threeSecondsAlias)
+
+	threeSecondTransport, ok := threeSeconds.Transport.(*http.Transport)
+	require.True(t, ok)
+	assert.Equal(t, 3*time.Second, threeSecondTransport.ResponseHeaderTimeout)
+
+	common.RelayResponseHeaderTimeout = 5
+	fiveSeconds, err := GetHttpClientWithProxyForRelay(proxyURL, settings, true)
+	require.NoError(t, err)
+	assert.NotSame(t, threeSeconds, fiveSeconds)
+	fiveSecondTransport, ok := fiveSeconds.Transport.(*http.Transport)
+	require.True(t, ok)
+	assert.Equal(t, 5*time.Second, fiveSecondTransport.ResponseHeaderTimeout)
+
+	InvalidateProxyClient(proxyURL)
+	fiveSecondsAfterInvalidation, err := GetHttpClientWithProxyForRelay(proxyURL, settings, true)
+	require.NoError(t, err)
+	assert.NotSame(t, fiveSeconds, fiveSecondsAfterInvalidation)
