+func newAwsResponseHeaderTimeoutRetryer() aws.Retryer {
+	return awsretry.NewStandard(func(options *awsretry.StandardOptions) {
+		timeoutRule := awsretry.IsErrorRetryableFunc(func(err error) aws.Ternary {
+			if channel.IsResponseHeaderTimeout(err) {
+				return aws.FalseTernary
+			}
+			return aws.UnknownTernary
+		})
+		options.Retryables = append(
+			[]awsretry.IsErrorRetryable{timeoutRule},
+			options.Retryables...,
+		)
+	})
+}
