+	require.True(t, ok)
+	assert.Equal(t, 5*time.Second, fiveSecondTransport.ResponseHeaderTimeout)
+	regularAfterInvalidation, err := GetHttpClientWithProxySettings(proxyURL, settings)
+	require.NoError(t, err)
+	assert.NotSame(t, regular, regularAfterInvalidation)
+
+	common.RelayResponseHeaderTimeout = 0
+	disabled, err := GetHttpClientWithProxyForRelay(proxyURL, settings, true)
+	require.NoError(t, err)
+	assert.Same(t, regularAfterInvalidation, disabled)
+}
