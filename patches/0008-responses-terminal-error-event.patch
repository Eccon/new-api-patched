+type responsesErrorDeadlineWriter struct {
+	*httptest.ResponseRecorder
+	deadlines []time.Time
+	writeErr  error
+}
+
+func (w *responsesErrorDeadlineWriter) SetWriteDeadline(deadline time.Time) error {
+	w.deadlines = append(w.deadlines, deadline)
+	return nil
+}
+
+func (w *responsesErrorDeadlineWriter) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	return w.ResponseRecorder.Write(p)
+}
+
+func TestResponsesSyntheticErrorUsesStreamWriteBudget(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		reason   string
+		sequence int
+		cancel   bool
+		fail     bool
+	}{
+		{name: "inactivity timeout retains prior large event budget", reason: "stream_timeout", sequence: 8},
+		{name: "read error retains prior large event budget", reason: "stream_read_error", sequence: 0},
+		{name: "disconnected client receives no error event", reason: "stream_timeout", cancel: true},
+		{name: "error event write failure aborts delivery", reason: "stream_read_error", fail: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			writer := &responsesErrorDeadlineWriter{ResponseRecorder: httptest.NewRecorder()}
+			c, _ := gin.CreateTestContext(writer)
+			ctx, cancel := context.WithCancel(context.Background())
+			t.Cleanup(cancel)
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil).WithContext(ctx)
+			helper.SetEventStreamHeaders(c)
+
+			// Seed a large-event budget without waiting for a real slow socket.
+			require.NoError(t, helper.StringData(c, strings.Repeat("x", 3600<<10)))
+			require.NotEmpty(t, writer.deadlines)
+			previousDeadline := writer.deadlines[len(writer.deadlines)-1]
+			writer.Body.Reset()
+			writer.deadlines = nil
+			if tc.cancel {
+				cancel()
+			}
+			if tc.fail {
+				writer.writeErr = errors.New("client stopped reading")
+			}
+
+			sendResponsesErrorEvent(c, tc.reason, tc.sequence)
+
+			if tc.cancel {
+				assert.Empty(t, writer.Body.String())
+				assert.Empty(t, writer.deadlines)
+				return
+			}
+			require.NotEmpty(t, writer.deadlines)
+			assert.True(t, writer.deadlines[0].After(previousDeadline), "error event must keep the existing stream budget")
+			if tc.fail {
+				assert.True(t, c.IsAborted())
+				require.NotEmpty(t, c.Errors)
+				assert.ErrorIs(t, c.Errors.Last().Err, writer.writeErr)
+				assert.Empty(t, writer.Body.String())
+				return
+			}
+			assert.True(t, writer.Flushed)
+			assert.True(t, strings.HasPrefix(writer.Body.String(), "event: error\ndata: "))
+			assert.True(t, strings.HasSuffix(writer.Body.String(), "\n\n"))
+			payload := strings.TrimSuffix(strings.TrimPrefix(writer.Body.String(), "event: error\ndata: "), "\n\n")
+			assert.JSONEq(t, fmt.Sprintf(`{"type":"error","sequence_number":%d,"code":%q,"message":%q,"param":null}`, tc.sequence, tc.reason, tc.reason), payload)
+		})
+	}
+}
