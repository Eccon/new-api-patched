+func TestPingDataWritesProtocolSpecificHeartbeat(t *testing.T) {
+	const (
+		legacyPing = ": PING\n\n"
+		typedPing  = ": PING\nevent: ping\ndata: {\"type\":\"ping\"}\n\n"
+	)
+
+	tests := []struct {
+		name       string
+		path       string
+		nilRequest bool
+		nilURL     bool
+		want       string
+	}{
+		{name: "chat completions", path: "/v1/chat/completions", want: legacyPing},
+		{name: "responses", path: "/v1/responses", want: typedPing},
+		{name: "claude messages", path: "/v1/messages", want: typedPing},
+		{name: "responses compact", path: "/v1/responses/compact", want: legacyPing},
+		{name: "empty path", want: legacyPing},
+		{name: "nil request", nilRequest: true, want: legacyPing},
+		{name: "nil URL", nilURL: true, want: legacyPing},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(recorder)
+			if !tt.nilRequest {
+				c.Request = httptest.NewRequest(http.MethodPost, "/", nil)
+				if tt.nilURL {
+					c.Request.URL = nil
+				} else {
+					c.Request.URL.Path = tt.path
+				}
+			}
+
+			require.NoError(t, PingData(c))
+			assert.Equal(t, tt.want, recorder.Body.String())
+		})
+	}
+}
