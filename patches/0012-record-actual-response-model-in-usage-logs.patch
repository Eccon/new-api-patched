+func (info *RelayInfo) SetResponseModelName(modelName string) {
+	if info == nil {
+		return
+	}
+	modelName = strings.TrimSpace(modelName)
+	if modelName == "" {
+		return
+	}
+	if info.ResponseModelName != "" {
+		return
+	}
+	info.ResponseModelName = modelName
+}
