+func appendRequestUserAgentToOther(c *gin.Context, other *LogOther) *LogOther {
+	if c == nil || c.Request == nil {
+		return other
+	}
+	userAgent := strings.TrimSpace(c.Request.UserAgent())
+	if userAgent == "" {
+		return other
+	}
+	userAgent = truncateUserAgent(userAgent)
+	if userAgent == "" {
+		return other
+	}
+	if other == nil {
+		other = NewLogOther()
+	}
+	other.SetPublic("request_user_agent", userAgent)
+	return other
+}
+
+func truncateUserAgent(userAgent string) string {
+	if len(userAgent) <= maxLoggedUserAgentLength {
+		return userAgent
+	}
+	userAgent = userAgent[:maxLoggedUserAgentLength]
+	for len(userAgent) > 0 && !utf8.ValidString(userAgent) {
+		userAgent = userAgent[:len(userAgent)-1]
+	}
+	return userAgent
+}
