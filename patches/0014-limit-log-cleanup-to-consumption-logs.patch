@@ -0,0 +1,57 @@
+package model
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDeleteOldLogBatchOnlyDeletesConsumptionLogs(t *testing.T) {
+	truncateTables(t)
+
+	const targetTimestamp int64 = 200
+	logs := []Log{
+		{CreatedAt: 100, Type: LogTypeConsume, Content: "old consumption"},
+		{CreatedAt: targetTimestamp, Type: LogTypeConsume, Content: "boundary consumption"},
+		{CreatedAt: 300, Type: LogTypeConsume, Content: "new consumption"},
+		{CreatedAt: 100, Type: LogTypeUnknown, Content: "old unknown"},
+		{CreatedAt: 100, Type: LogTypeTopup, Content: "old topup"},
+		{CreatedAt: 100, Type: LogTypeManage, Content: "old management"},
+		{CreatedAt: 100, Type: LogTypeSystem, Content: "old system"},
+		{CreatedAt: 100, Type: LogTypeError, Content: "old error"},
+		{CreatedAt: 100, Type: LogTypeRefund, Content: "old refund"},
+		{CreatedAt: 100, Type: LogTypeLogin, Content: "old login"},
+	}
+	require.NoError(t, LOG_DB.Create(&logs).Error)
+
+	total, err := CountOldLog(context.Background(), targetTimestamp)
+	require.NoError(t, err)
+	assert.Equal(t, int64(1), total)
+
+	deleted, err := DeleteOldLogBatch(context.Background(), targetTimestamp, 100)
+	require.NoError(t, err)
+	assert.Equal(t, int64(1), deleted)
+
+	var remaining []Log
+	require.NoError(t, LOG_DB.Order("id asc").Find(&remaining).Error)
+	require.Len(t, remaining, len(logs)-1)
+
+	remainingContent := make([]string, 0, len(remaining))
+	for _, log := range remaining {
+		remainingContent = append(remainingContent, log.Content)
+	}
+	assert.NotContains(t, remainingContent, "old consumption")
+	assert.ElementsMatch(t, []string{
+		"boundary consumption",
+		"new consumption",
+		"old unknown",
+		"old topup",
+		"old management",
+		"old system",
+		"old error",
+		"old refund",
+		"old login",
+	}, remainingContent)
+}
