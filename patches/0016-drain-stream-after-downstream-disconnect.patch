diff --git a/controller/relay_stream_delivery_test.go b/controller/relay_stream_delivery_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..546301bd78fb434c1e74a933723ee8ed5cce72a7
--- /dev/null
+++ b/controller/relay_stream_delivery_test.go
@@ -0,0 +1,80 @@
+package controller
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	relayhelper "github.com/QuantumNous/new-api/relay/helper"
+	"github.com/QuantumNous/new-api/relaykit/types"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type disconnectingRelayWriter struct {
+	gin.ResponseWriter
+	writes atomic.Int64
+}
+
+func (w *disconnectingRelayWriter) Write(p []byte) (int, error) {
+	w.writes.Add(1)
+	if strings.Contains(string(p), ": PING") {
+		return 0, errors.New("downstream write failed")
+	}
+	return w.ResponseWriter.Write(p)
+}
+
+func newDisconnectedRelayContext(t *testing.T, body string) (*gin.Context, *disconnectingRelayWriter) {
+	t.Helper()
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(body))
+	c.Request.Header.Set("Content-Type", "application/json")
+	writer := &disconnectingRelayWriter{ResponseWriter: c.Writer}
+	c.Writer = writer
+	require.Error(t, relayhelper.PingData(c))
+	require.True(t, relayhelper.IsStreamDeliveryDisconnected(c))
+	require.NoError(t, c.Request.Context().Err())
+	return c, writer
+}
+
+func TestShouldRetryStopsAfterStreamDeliveryDisconnect(t *testing.T) {
+	c, _ := newDisconnectedRelayContext(t, `{}`)
+	retryable := types.NewError(errors.New("upstream failed"), types.ErrorCode("channel:test"))
+
+	assert.False(t, shouldRetry(c, retryable, 1))
+}
+
+func TestRelayDoesNotWriteFinalErrorAfterStreamDeliveryDisconnect(t *testing.T) {
+	c, writer := newDisconnectedRelayContext(t, `{`)
+	t.Cleanup(func() { common.CleanupBodyStorage(c) })
+	writesBeforeRelay := writer.writes.Load()
+
+	Relay(c, types.RelayFormatOpenAI)
+
+	assert.Equal(t, writesBeforeRelay, writer.writes.Load())
+}
+
+func TestRelayDoesNotWriteFinalErrorAfterContextCancel(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{`)).WithContext(ctx)
+	c.Request.Header.Set("Content-Type", "application/json")
+	writer := &disconnectingRelayWriter{ResponseWriter: c.Writer}
+	c.Writer = writer
+	t.Cleanup(func() { common.CleanupBodyStorage(c) })
+
+	Relay(c, types.RelayFormatOpenAI)
+
+	assert.False(t, relayhelper.IsStreamDeliveryDisconnected(c))
+	assert.Zero(t, writer.writes.Load())
+}
