+package helper
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+
+	"github.com/QuantumNous/new-api/common"
+
+	"github.com/gin-gonic/gin"
+)
+
+const streamDeliveryStateKey = "relay_stream_delivery_state"
+
+type streamDeliveryState struct {
+	active       atomic.Bool
+	disconnected atomic.Bool
+}
+
+func enableStreamDrainOnDisconnect(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	state := getStreamDeliveryState(c)
+	if state == nil {
+		state = &streamDeliveryState{}
+		c.Set(streamDeliveryStateKey, state)
+	}
+	state.active.Store(true)
+}
+
+func getStreamDeliveryState(c *gin.Context) *streamDeliveryState {
+	if c == nil {
+		return nil
+	}
+	value, exists := c.Get(streamDeliveryStateKey)
+	if !exists {
+		return nil
+	}
+	state, _ := value.(*streamDeliveryState)
+	return state
+}
+
+func isStreamDrainActive(c *gin.Context) bool {
+	state := getStreamDeliveryState(c)
+	return state != nil && state.active.Load()
+}
+
+func shouldSuppressStreamWrite(c *gin.Context) bool {
+	state := getStreamDeliveryState(c)
+	if state == nil || !state.active.Load() {
+		return false
+	}
+	if requestContextDone(c) {
+		state.markDisconnected()
+	}
+	return state.disconnected.Load()
+}
+
+func markStreamDeliveryDisconnected(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	state := getStreamDeliveryState(c)
+	if state == nil {
+		state = &streamDeliveryState{}
+		c.Set(streamDeliveryStateKey, state)
+	}
+	state.markDisconnected()
+}
+
+func (s *streamDeliveryState) markDisconnected() {
+	if s == nil {
+		return
+	}
+	s.disconnected.Store(true)
+}
+
+func handleStreamWriteError(c *gin.Context, err error) error {
+	if err == nil {
+		return nil
+	}
+	state := getStreamDeliveryState(c)
+	if state == nil || !state.active.Load() {
+		return err
+	}
+	state.markDisconnected()
+	return nil
+}
+
+// writeStreamEvent preserves common.CustomEvent's SSE framing while returning
+// writer errors for streams that opted into drain-on-disconnect handling.
+func writeStreamEvent(c *gin.Context, data string) error {
+	if c == nil || c.Writer == nil {
+		return errors.New("context or writer is nil")
+	}
+	state := getStreamDeliveryState(c)
+	if state == nil || !state.active.Load() {
+		c.Render(-1, common.CustomEvent{Data: data})
+		return nil
+	}
+	if shouldSuppressStreamWrite(c) {
+		return nil
+	}
+
+	header := c.Writer.Header()
+	header["Content-Type"] = []string{"text/event-stream"}
+	if _, exists := header["Cache-Control"]; !exists {
+		header["Cache-Control"] = []string{"no-cache"}
+	}
+
+	encoded := strings.ReplaceAll(data, "\r", "\\r")
+	if strings.HasPrefix(data, "data") {
+		encoded += "\n\n"
+	}
+	n, err := c.Writer.Write([]byte(encoded))
+	if err != nil {
+		return fmt.Errorf("write stream event failed: %w", err)
+	}
+	if n != len(encoded) {
+		return io.ErrShortWrite
+	}
+	return nil
+}
+
+func flushStreamWriter(w http.ResponseWriter) error {
+	if flusher, ok := w.(interface{ FlushError() error }); ok {
+		return flusher.FlushError()
+	}
+	if unwrapper, ok := w.(interface{ Unwrap() http.ResponseWriter }); ok {
+		err := http.NewResponseController(unwrapper.Unwrap()).Flush()
+		if err == nil || !errors.Is(err, http.ErrNotSupported) {
+			return err
+		}
+	}
+	if flusher, ok := w.(http.Flusher); ok {
+		flusher.Flush()
+		return nil
+	}
+	return http.ErrNotSupported
+}
+
+// IsStreamDeliveryDisconnected reports whether downstream delivery for the
+// shared stream stopped because its request was canceled or a write failed.
+func IsStreamDeliveryDisconnected(c *gin.Context) bool {
+	state := getStreamDeliveryState(c)
+	return state != nil && state.disconnected.Load()
+}
+
+// DeactivateStreamDrainForRetry prevents a later relay attempt from inheriting
+// drain behavior that was enabled by a shared scanner in the previous attempt.
+func DeactivateStreamDrainForRetry(c *gin.Context) {
+	state := getStreamDeliveryState(c)
+	if state == nil || state.disconnected.Load() {
+		return
+	}
+	state.active.Store(false)
+}
+
+func shouldWriteStreamResponse(c *gin.Context) bool {
+	if c == nil || c.Writer == nil {
+		return false
+	}
+	if shouldSuppressStreamWrite(c) {
+		return false
+	}
+	if requestContextDone(c) {
+		if isStreamDrainActive(c) {
+			markStreamDeliveryDisconnected(c)
+		}
+		return false
+	}
+	return true
+}
