+func TestStreamScannerHandler_PingWriteFailureDrainsUpstream(t *testing.T) {
+	setting := operation_setting.GetGeneralSetting()
+	oldEnabled := setting.PingIntervalEnabled
+	oldSeconds := setting.PingIntervalSeconds
+	setting.PingIntervalEnabled = true
+	setting.PingIntervalSeconds = 1
+	t.Cleanup(func() {
+		setting.PingIntervalEnabled = oldEnabled
+		setting.PingIntervalSeconds = oldSeconds
+	})
+
+	oldTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 5
+	t.Cleanup(func() { constant.StreamingTimeout = oldTimeout })
+
+	pr, pw := io.Pipe()
+	t.Cleanup(func() {
+		_ = pr.Close()
+		_ = pw.Close()
+	})
+
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+	pingAttempted := make(chan struct{})
+	releasePing := make(chan struct{})
+	t.Cleanup(func() {
+		select {
+		case <-releasePing:
+		default:
+			close(releasePing)
+		}
+	})
+	c.Writer = &failingPingWriter{
+		ResponseWriter: c.Writer,
+		err:            errors.New("client connection closed"),
+		attempted:      pingAttempted,
+		release:        releasePing,
+	}
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}}
+	var usageSeen atomic.Bool
+	var disconnectedBeforeUsage atomic.Bool
+	done := make(chan struct{})
+
+	go func() {
+		StreamScannerHandler(c, &http.Response{Body: pr}, info, func(data string, sr *StreamResult) {
+			_ = StringData(c, data)
+			if data == "usage" {
+				usageSeen.Store(true)
+				disconnectedBeforeUsage.Store(IsStreamDeliveryDisconnected(c))
+			}
+		})
+		close(done)
+	}()
+
+	select {
+	case <-pingAttempted:
+	case <-time.After(3 * time.Second):
+		t.Fatal("timed out waiting for failed ping write")
+	}
+
+	upstreamWrite := make(chan error, 1)
+	go func() {
+		_, err := fmt.Fprint(pw, "data: usage\ndata: [DONE]\n")
+		upstreamWrite <- err
+	}()
+	select {
+	case err := <-upstreamWrite:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("scanner did not read upstream while ping write was blocked")
+	}
+	close(releasePing)
+	require.Eventually(t, func() bool { return IsStreamDeliveryDisconnected(c) }, 2*time.Second, 10*time.Millisecond)
+
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("handler did not finish after upstream completion")
+	}
+
+	assert.True(t, usageSeen.Load())
+	assert.True(t, disconnectedBeforeUsage.Load(), "delivery must be disabled before the next callback acquires the write lock")
+	assert.Equal(t, relaycommon.StreamEndReasonDone, info.StreamStatus.EndReason)
+	assert.True(t, IsStreamDeliveryDisconnected(c))
+	assert.NotContains(t, recorder.Body.String(), "usage")
+}
