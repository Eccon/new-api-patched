+
+func (w *unsupportedFlushGinWriter) FlushError() error {
+	return http.ErrNotSupported
+}
+
+func (w *panickingPingWriter) Write([]byte) (int, error) {
+	panic("writer implementation panic")
+}
+
+func (w *failingDataWriter) Write(p []byte) (int, error) {
+	w.attempts.Add(1)
+	if bytes.Contains(p, w.needle) {
+		return 0, w.err
+	}
+	return w.ResponseWriter.Write(p)
+}
+
+func (w *cancelAfterStreamWriteWriter) Write(p []byte) (int, error) {
+	w.writes.Add(1)
+	n, err := w.ResponseWriter.Write(p)
+	if bytes.Contains(p, w.needle) {
+		w.cancel()
+	}
+	return n, err
+}
+
+func (w *failingPingWriter) Write(p []byte) (int, error) {
+	if bytes.Contains(p, []byte(": PING")) {
+		w.once.Do(func() { close(w.attempted) })
+		<-w.release
+		return 0, w.err
+	}
+	return w.ResponseWriter.Write(p)
+}
