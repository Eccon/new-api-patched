+func relayTimingSince(start, value time.Time) string {
+	if start.IsZero() || value.IsZero() {
+		return "-"
+	}
+	return fmt.Sprintf("%dms", value.Sub(start).Milliseconds())
+}
+
+func relayTimingDuration(start, end time.Time) string {
+	if start.IsZero() || end.IsZero() {
+		return "-"
+	}
+	return fmt.Sprintf("%dms", end.Sub(start).Milliseconds())
+}
+
+func logRelayTiming(ctx *gin.Context, relayInfo *relaycommon.RelayInfo) {
+	if !common.RelayTimingLogEnabled || relayInfo == nil {
+		return
+	}
+	t := relayInfo.Timing.Snapshot()
+	start := t.RequestReceivedAt
+	if start.IsZero() {
+		start = t.RelayEnter
+	}
+	if start.IsZero() {
+		start = relayInfo.StartTime
+	}
+	streamEnd := time.Time{}
+	if relayInfo.IsStream {
+		streamEnd = t.StreamEnd
+	}
+	if relayInfo.IsStream && streamEnd.IsZero() {
+		streamEnd = t.QuotaLogStart
+	}
+	quotaLog := t.QuotaLogStart
+	if quotaLog.IsZero() {
+		quotaLog = time.Now()
+	}
+	idle := "-"
+	if t.WasIdleConn {
+		idle = fmt.Sprintf("%dms", t.IdleTime.Milliseconds())
+	}
+	writeErr := common.MaskSensitiveInfo(t.WriteErr)
+	logger.LogInfo(ctx, fmt.Sprintf(
+		"relay timing: channel=%d model=%q stream=%t upstream_status=%d reused=%t was_idle=%t idle=%s write_err=%q since_start{do_start=%s got_conn=%s wrote_req=%s first_byte=%s do_return=%s first_data=%s stream_end=%s quota_log=%s} duration{pre_do=%s dns=%s connect=%s tls=%s write_to_first_byte=%s do_total=%s do_return_to_first_data=%s first_byte_to_first_data=%s first_data_to_stream_end=%s total=%s}",
+		relayInfo.ChannelId,
+		relayInfo.OriginModelName,
+		relayInfo.IsStream,
+		t.UpstreamStatus,
+		t.ReusedConn,
+		t.WasIdleConn,
+		idle,
+		writeErr,
+		relayTimingSince(start, t.DoStart),
+		relayTimingSince(start, t.GotConn),
+		relayTimingSince(start, t.WroteRequest),
+		relayTimingSince(start, t.FirstByte),
+		relayTimingSince(start, t.DoReturn),
+		relayTimingSince(start, t.FirstData),
+		relayTimingSince(start, streamEnd),
+		relayTimingSince(start, quotaLog),
+		relayTimingDuration(start, t.DoStart),
+		relayTimingDuration(t.DNSStart, t.DNSDone),
+		relayTimingDuration(t.ConnectStart, t.ConnectDone),
+		relayTimingDuration(t.TLSStart, t.TLSDone),
+		relayTimingDuration(t.WroteRequest, t.FirstByte),
+		relayTimingDuration(t.DoStart, t.DoReturn),
+		relayTimingDuration(t.DoReturn, t.FirstData),
+		relayTimingDuration(t.FirstByte, t.FirstData),
+		relayTimingDuration(t.FirstData, streamEnd),
+		relayTimingDuration(start, quotaLog),
+	))
+}
