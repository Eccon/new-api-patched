+
+func (t *relayHTTPTrace) clientTrace() *httptrace.ClientTrace {
+	return &httptrace.ClientTrace{
+		DNSStart: func(httptrace.DNSStartInfo) {
+			t.mu.Lock()
+			if t.timing.DNSStart.IsZero() {
+				t.timing.DNSStart = time.Now()
+			}
+			t.mu.Unlock()
+		},
+		DNSDone: func(httptrace.DNSDoneInfo) {
+			t.mu.Lock()
+			t.timing.DNSDone = time.Now()
+			t.mu.Unlock()
+		},
+		ConnectStart: func(_, _ string) {
+			t.mu.Lock()
+			if t.timing.ConnectStart.IsZero() {
+				t.timing.ConnectStart = time.Now()
+			}
+			t.mu.Unlock()
+		},
+		ConnectDone: func(_, _ string, _ error) {
+			t.mu.Lock()
+			t.timing.ConnectDone = time.Now()
+			t.mu.Unlock()
+		},
+		TLSHandshakeStart: func() {
+			t.mu.Lock()
+			if t.timing.TLSStart.IsZero() {
+				t.timing.TLSStart = time.Now()
+			}
+			t.mu.Unlock()
+		},
+		TLSHandshakeDone: func(_ tls.ConnectionState, _ error) {
+			t.mu.Lock()
+			t.timing.TLSDone = time.Now()
+			t.mu.Unlock()
+		},
+		GotConn: func(connInfo httptrace.GotConnInfo) {
+			t.mu.Lock()
+			t.timing.GotConn = time.Now()
+			t.timing.ReusedConn = connInfo.Reused
+			t.timing.WasIdleConn = connInfo.WasIdle
+			t.timing.IdleTime = connInfo.IdleTime
+			t.mu.Unlock()
+		},
+		WroteRequest: func(writeInfo httptrace.WroteRequestInfo) {
+			now := time.Now()
+			t.mu.Lock()
+			t.timing.WroteRequest = now
+			t.writeSeq++
+			writeSeq := t.writeSeq
+			if writeInfo.Err != nil {
+				t.timing.WriteErr = writeInfo.Err.Error()
+			} else {
+				t.timing.WriteErr = ""
+			}
+			doStart := t.timing.DoStart
+			t.mu.Unlock()
+
+			// This confirms the local transport finished writing; it is not an upstream acknowledgement.
+			if writeInfo.Err == nil {
+				logger.LogInfo(t.logContext, fmt.Sprintf(
+					"relay upstream request written: channel=%d model=%q stream=%t retry=%d write_seq=%d since_do_start=%s",
+					t.channelID,
+					t.model,
+					t.stream,
+					t.retryIndex,
+					writeSeq,
+					relayAttemptTimingSince(doStart, now),
+				))
+			}
+		},
+		GotFirstResponseByte: func() {
+			t.mu.Lock()
+			t.timing.FirstByte = time.Now()
+			t.mu.Unlock()
+		},
+	}
+}
+
+func (t *relayHTTPTrace) finish(resp *http.Response) (common.RelayTimingInfo, int) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.timing.DoReturn = time.Now()
+	if resp != nil {
+		t.timing.UpstreamStatus = resp.StatusCode
+	}
+	return t.timing, t.writeSeq
+}
+
+func (t *relayHTTPTrace) snapshot() common.RelayTimingInfo {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.timing
+}
